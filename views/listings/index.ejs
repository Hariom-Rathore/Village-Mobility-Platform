<% layout("/listings/layouts/boilerplate") %>
<% var tripType = typeof currentTripType !== 'undefined' ? currentTripType : ''; %>
<div class="listings-page">
  <!-- Filters -->
  <div class="listings-filters">
    <a href="/cars" class="filter-link <%= !tripType ? 'active' : '' %>">
      <div class="filter"><i class="fa-solid fa-fire"></i><p>All</p></div>
    </a>
    <a href="/cars?tripType=local" class="filter-link <%= tripType === 'local' ? 'active' : '' %>">
      <div class="filter"><i class="fa-solid fa-city"></i><p>Local Trips</p></div>
    </a>
    <a href="/cars?tripType=outstation" class="filter-link <%= tripType === 'outstation' ? 'active' : '' %>">
      <div class="filter"><i class="fa-solid fa-road"></i><p>Outstation</p></div>
    </a>
    <a href="/cars?tripType=wedding" class="filter-link <%= tripType === 'wedding' ? 'active' : '' %>">
      <div class="filter"><i class="fa-solid fa-ring"></i><p>Wedding</p></div>
    </a>
    <a href="/cars?tripType=airport-pickup" class="filter-link <%= tripType === 'airport-pickup' ? 'active' : '' %>">
      <div class="filter"><i class="fa-solid fa-plane"></i><p>Airport</p></div>
    </a>
    <a href="/cars?tripType=temple-visit" class="filter-link <%= tripType === 'temple-visit' ? 'active' : '' %>">
      <div class="filter"><i class="fa-solid fa-place-of-worship"></i><p>Temple Visit</p></div>
    </a>
    <a href="/cars?tripType=tourism" class="filter-link <%= tripType === 'tourism' ? 'active' : '' %>">
      <div class="filter"><i class="fa-solid fa-mountain"></i><p>Tour Package</p></div>
    </a>
    <a href="/cars?tripType=corporate" class="filter-link <%= tripType === 'corporate' ? 'active' : '' %>">
      <div class="filter"><i class="fa-solid fa-briefcase"></i><p>Corporate</p></div>
    </a>
    <a href="/cars?tripType=railway-pickup" class="filter-link <%= tripType === 'railway-pickup' ? 'active' : '' %>">
      <div class="filter"><i class="fa-solid fa-train"></i><p>Railway</p></div>
    </a>
    <a href="/cars?tripType=family" class="filter-link <%= tripType === 'family' ? 'active' : '' %>">
      <div class="filter"><i class="fa-solid fa-people-group"></i><p>Family</p></div>
    </a>
    <label class="tax-toggle">
      <input type="checkbox" id="taxSwitch">
      <span>Display total after taxes</span>
    </label>
  </div>

  <!-- Grid -->
  <% if (!alllistings || alllistings.length === 0) { %>
    <div class="empty-state" style="margin-top:40px">
      <i class="fas fa-car"></i>
      <h3>No vehicles found</h3>
      <p><% if (currentSearch && currentSearch.trim()) { %>No results for "<%= currentSearch %>"<% } else if (tripType) { %>No vehicles found for this trip type. Try a different category.<% } else { %>Try adjusting your filters<% } %></p>
    </div>
  <% } else { %>
    <div class="listings-grid">
      <% for(let listing of alllistings){ %>
        <% let imgUrl = "https://images.pexels.com/photos/11129937/pexels-photo-11129937.jpeg";
           if (listing.image && listing.image.url) {
             imgUrl = listing.image.url;
             if (imgUrl.includes('cloudinary.com')) imgUrl = imgUrl.replace('/upload/', '/upload/q_auto,f_auto,w_400,h_300,c_limit/');
             else if (imgUrl.includes('unsplash.com') && !imgUrl.includes('?')) imgUrl += '?auto=format&fit=crop&w=400&q=80';
           } else if (typeof listing.image === "string") {
             imgUrl = listing.image;
             if (imgUrl.includes('unsplash.com') && !imgUrl.includes('?')) imgUrl += '?auto=format&fit=crop&w=400&q=80';
           }
        %>
        <% const av = listing.availabilityStatus || 'AVAILABLE'; %>
        <% const badgeMap = { AVAILABLE: ['success','Available'], BOOKED: ['danger','Booked'], RESERVED: ['warning','Reserved'], UNDER_MAINTENANCE: ['secondary','Maintenance'], HIDDEN: ['secondary','Hidden'] }; %>
        <% const [badgeColor, badgeText] = badgeMap[av] || ['secondary','Unknown']; %>
        <a href="/cars/<%=listing._id%>" class="listing-card-link">
          <div class="card listing-card">
            <div class="listing-card-img-wrap">
              <img src="<%= imgUrl %>" alt="<%= listing.title %>" loading="lazy" onerror="this.src='https://images.pexels.com/photos/11129937/pexels-photo-11129937.jpeg'">
              <span class="badge badge-<%= badgeColor %> listing-badge"><%= badgeText %></span>
            </div>
            <div class="card-body">
              <h4><%= listing.title %></h4>
              <p class="price">
                &#8377; <%= listing.price != null ? listing.price.toLocaleString("en-IN") : "—" %>
                <small>/day</small>
                <% if(listing.ratePerKm != null) { %><br><small class="km-rate">&#8377; <%= listing.ratePerKm %>/km</small><% } %>
                <i class="tax-info" style="display:none"> &nbsp;+18% GST</i>
              </p>
              <% if (listing.averageRating && listing.totalReviews > 0) { %>
                <div class="listing-rating">
                  <% for(let i = 1; i <= 5; i++) { %>
                    <i class="<%= i <= Math.floor(listing.averageRating) ? 'fas' : (i <= listing.averageRating ? 'fas fa-star-half-alt' : 'far') %> fa-star"></i>
                  <% } %>
                  <span>(<%= listing.totalReviews %>)</span>
                </div>
              <% } %>
            </div>
          </div>
        </a>
      <% } %>
    </div>
  <% } %>
</div>

<script>
document.getElementById('taxSwitch')?.addEventListener('change', function() {
  document.querySelectorAll('.tax-info').forEach(e => e.style.display = this.checked ? 'inline' : 'none');
});
</script>

<style>
.listings-page { padding: 24px 24px 48px; max-width: var(--max-width); margin: 0 auto; }
.listings-filters { display: flex; flex-wrap: nowrap; align-items: center; gap: 4px; overflow-x: auto; padding: 4px 0 12px; margin-bottom: 24px; }
.filter-link { text-decoration: none; color: var(--text-secondary); flex: 0 0 auto; }
.filter { display: flex; flex-direction: column; align-items: center; padding: 10px 14px; border-radius: var(--radius-lg); transition: all 0.2s; min-width: 80px; cursor: pointer; }
.filter:hover { background: var(--surface); }
.filter-link.active .filter { background: var(--primary-50); color: var(--primary); }
.filter i { font-size: 18px; }
.filter p { margin: 4px 0 0; font-size: 11px; font-weight: 500; white-space: nowrap; }
.tax-toggle { display: flex; align-items: center; gap: 8px; margin-left: auto; padding: 8px 14px; border: 1px solid var(--border); border-radius: var(--radius-full); white-space: nowrap; cursor: pointer; font-size: 12px; color: var(--text-secondary); flex-shrink: 0; }
.tax-toggle input[type="checkbox"] { accent-color: var(--primary); width: 14px; height: 14px; }
.listings-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px; }
.listing-card-link { text-decoration: none; color: inherit; display: block; transition: transform 0.2s; }
.listing-card-link:hover { transform: translateY(-4px); }
.listing-card { overflow: hidden; }
.listing-card-img-wrap { position: relative; height: 200px; overflow: hidden; background: var(--surface); }
.listing-card-img-wrap img { width: 100%; height: 100%; object-fit: cover; }
.listing-badge { position: absolute; top: 12px; right: 12px; }
.listing-card .card-body h4 { font-size: 16px; font-weight: 700; margin-bottom: 4px; }
.listing-card .card-body .price { font-size: 18px; font-weight: 700; color: var(--primary); }
.listing-card .card-body .price small { font-size: 12px; font-weight: 400; color: var(--text-secondary); }
.listing-card .card-body .km-rate { font-size: 12px; color: var(--text-secondary); font-weight: 400; }
.listing-rating { color: #f59e0b; font-size: 12px; margin-top: 6px; }
.listing-rating span { color: var(--text-secondary); margin-left: 4px; }
</style>
