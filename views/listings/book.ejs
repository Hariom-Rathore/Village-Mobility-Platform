<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0,maximum-scale=1.0,user-scalable=no">
<title>Book - RideLocal</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<style>
:root{--primary:#2563eb;--primary-dark:#1d4ed8;--primary-light:#dbeafe;--bg:#f0f4f9;--card:#fff;--text:#0f172a;--text2:#475569;--text3:#94a3b8;--border:#e2e8f0;--success:#10b981;--warning:#f59e0b;--radius:16px;}
*{margin:0;padding:0;box-sizing:border-box;}
body{font-family:'Inter',-apple-system,sans-serif;background:var(--bg);color:var(--text);-webkit-font-smoothing:antialiased;}
.app{max-width:480px;margin:0 auto;min-height:100vh;background:var(--card);}

/* Header */
.top-bar{display:flex;align-items:center;gap:12px;padding:14px 16px;border-bottom:1px solid var(--border);position:sticky;top:0;background:var(--card);z-index:10;}
.top-bar .back{width:36px;height:36px;border:none;border-radius:50%;background:var(--bg);display:flex;align-items:center;justify-content:center;color:var(--text2);font-size:14px;cursor:pointer;transition:all .15s;text-decoration:none;}
.top-bar .back:active{transform:scale(0.9);}
.top-bar h1{font-size:17px;font-weight:700;flex:1;}

/* Content */
.content{padding:16px;}

/* Vehicle Hero Card */
.v-hero{background:linear-gradient(135deg,#f8fafc,#fff);border-radius:20px;padding:16px;display:flex;gap:14px;margin-bottom:16px;border:1px solid var(--border);}
.v-hero img{width:100px;height:76px;border-radius:12px;object-fit:cover;background:var(--bg);flex-shrink:0;}
.v-hero-body{flex:1;min-width:0;}
.v-hero-body h2{font-size:16px;font-weight:700;}
.v-hero-body .meta{font-size:12px;color:var(--text3);margin:2px 0 4px;display:flex;gap:8px;flex-wrap:wrap;}
.v-hero-body .meta span{display:flex;align-items:center;gap:3px;}
.v-hero-body .price-badge{display:inline-block;background:var(--primary-light);color:var(--primary);padding:4px 12px;border-radius:20px;font-size:13px;font-weight:700;}

/* Section Card */
.section-card{background:var(--card);border-radius:var(--radius);padding:16px;margin-bottom:12px;border:1px solid var(--border);}
.section-card h3{font-size:13px;font-weight:600;color:var(--text3);text-transform:uppercase;letter-spacing:0.3px;margin-bottom:12px;display:flex;align-items:center;gap:6px;}
.section-card h3 i{color:var(--primary);}

.info-row{display:flex;align-items:flex-start;gap:10px;padding:8px 0;}
.info-row:not(:last-child){border-bottom:1px solid var(--border);}
.info-row .i-icon{width:32px;height:32px;border-radius:10px;background:var(--bg);display:flex;align-items:center;justify-content:center;color:var(--text2);font-size:13px;flex-shrink:0;}
.info-row .i-icon.green{background:#d1fae5;color:#059669;}
.info-row .i-icon.red{background:#fee2e2;color:#dc2626;}
.info-row .i-label{font-size:11px;color:var(--text3);}
.info-row .i-value{font-size:13px;font-weight:600;color:var(--text);}

/* Fare Breakdown */
.fare-card{background:var(--card);border-radius:var(--radius);padding:16px;margin-bottom:16px;border:1px solid var(--border);}
.fare-card h3{font-size:13px;font-weight:600;color:var(--text3);text-transform:uppercase;letter-spacing:0.3px;margin-bottom:10px;display:flex;align-items:center;gap:6px;}
.fare-card h3 i{color:var(--primary);}
.fare-row{display:flex;justify-content:space-between;padding:5px 0;font-size:13px;color:var(--text2);}
.fare-row .val{font-weight:600;color:var(--text);}
.fare-divider{height:1px;background:var(--border);margin:8px 0;}
.fare-row.total{font-size:16px;font-weight:700;color:var(--text);}
.fare-row.total .val{color:var(--primary);font-size:18px;}

/* Form */
.form-group{margin-bottom:14px;}
.form-group label{display:block;font-size:11px;font-weight:600;color:var(--text3);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:4px;}
.input-wrap{display:flex;align-items:center;background:var(--bg);border:2px solid transparent;border-radius:12px;padding:0 14px;transition:all .2s;min-height:48px;}
.input-wrap:focus-within{border-color:var(--primary);background:var(--card);box-shadow:0 0 0 4px rgba(37,99,235,0.08);}
.input-wrap .icon{width:22px;text-align:center;flex-shrink:0;font-size:13px;color:var(--text3);}
.input-wrap input,.input-wrap select,.input-wrap textarea{flex:1;border:none;background:transparent;padding:12px 8px;font-size:14px;outline:none;font-family:inherit;color:var(--text);}
.input-wrap input::placeholder,.input-wrap textarea::placeholder{color:var(--text3);}
.input-wrap textarea{resize:vertical;min-height:60px;}
.form-row2{display:grid;grid-template-columns:1fr 1fr;gap:10px;}

.btn-primary{width:100%;background:linear-gradient(135deg,var(--primary),#7c3aed);color:#fff;border:none;border-radius:14px;padding:16px;font-size:16px;font-weight:700;cursor:pointer;transition:all .2s;display:flex;align-items:center;justify-content:center;gap:8px;}
.btn-primary:active{transform:scale(0.97);opacity:0.9;}
.btn-primary:disabled{opacity:0.5;cursor:not-allowed;transform:none;}
.btn-primary i{font-size:15px;}

/* Status Badge */
.status-badge{display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:20px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.3px;}
.status-pending{background:#fef3c7;color:#92400e;}
.status-confirmed{background:#d1fae5;color:#065f46;}

/* Mobile */
@media(max-width:400px){
  .form-row2{grid-template-columns:1fr;}
  .v-hero{flex-direction:column;}
  .v-hero img{width:100%;height:160px;}
}

/* Animation */
@keyframes fadeUp{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
.content>*{animation:fadeUp .3s ease-out both;}
.content>*:nth-child(2){animation-delay:0.05s}
.content>*:nth-child(3){animation-delay:0.1s}
.content>*:nth-child(4){animation-delay:0.15s}
</style>
</head>
<body>
<div class="app">
  <div class="top-bar">
    <a class="back" href="/customers/home"><i class="fas fa-arrow-left"></i></a>
    <h1>Book Your Ride</h1>
  </div>

  <div class="content">
    <!-- Vehicle Hero -->
    <div class="v-hero">
      <img src="<%= listing.images?.[0]?.url || listing.image?.url || 'https://images.pexels.com/photos/11129937/pexels-photo-11129937.jpeg' %>"
           onerror="this.src='https://images.pexels.com/photos/11129937/pexels-photo-11129937.jpeg'">
      <div class="v-hero-body">
        <h2><%= listing.vehicleName || listing.title %></h2>
        <div class="meta">
          <span><i class="fas fa-car"></i> <%= listing.vehicleType || listing.carType || 'Sedan' %></span>
          <span><i class="fas fa-users"></i> <%= listing.seats || 4 %> seats</span>
          <span><i class="fas fa-snowflake"></i> <%= listing.acAvailable ? 'AC' : 'Non-AC' %></span>
          <span><i class="fas fa-gear"></i> <%= listing.transmission === 'automatic' ? 'Auto' : 'Manual' %></span>
        </div>
        <% if(searchParams?.fare) { %>
          <div class="price-badge">₹<%= searchParams.fare.toLocaleString('en-IN') %> est.</div>
        <% } %>
      </div>
    </div>

    <!-- Trip Details -->
    <div class="section-card">
      <h3><i class="fas fa-route"></i> Trip Details</h3>
      <div class="info-row">
        <div class="i-icon green"><i class="fas fa-circle-dot"></i></div>
        <div><div class="i-label">Pickup</div><div class="i-value"><%= searchParams?.pickup || '—' %></div></div>
      </div>
      <div class="info-row">
        <div class="i-icon red"><i class="fas fa-location-dot"></i></div>
        <div><div class="i-label">Destination</div><div class="i-value"><%= searchParams?.destination || '—' %></div></div>
      </div>
      <% if(searchParams?.distance) { %>
      <div class="info-row">
        <div class="i-icon"><i class="fas fa-road"></i></div>
        <div><div class="i-label">Distance</div><div class="i-value"><%= searchParams.distance %> km</div></div>
      </div>
      <% } %>
      <div class="info-row">
        <div class="i-icon"><i class="fas fa-calendar"></i></div>
        <div><div class="i-label">Date &amp; Time</div><div class="i-value"><%= searchParams?.date || 'Today' %> · <%= searchParams?.time || 'Now' %></div></div>
      </div>
      <div class="info-row">
        <div class="i-icon"><i class="fas fa-users"></i></div>
        <div><div class="i-label">Passengers</div><div class="i-value"><%= searchParams?.passengers || 1 %> person(s)</div></div>
      </div>
    </div>

    <!-- Fare Breakdown -->
    <div class="fare-card">
      <h3><i class="fas fa-receipt"></i> Fare Estimate</h3>
      <div class="fare-row">
        <span>Base Fare</span>
        <span class="val">₹<%= (listing.baseFare || listing.price || 0).toLocaleString('en-IN') %></span>
      </div>
      <div class="fare-row">
        <span>Distance Charge (<%= searchParams?.distance || 0 %> km × ₹<%= listing.pricePerKm || listing.ratePerKm || 0 %>/km)</span>
        <span class="val">₹<%= ((searchParams?.distance || 0) * (listing.pricePerKm || listing.ratePerKm || 0)).toLocaleString('en-IN') %></span>
      </div>
      <div class="fare-divider"></div>
      <div class="fare-row total">
        <span>Estimated Total</span>
        <span class="val" id="totalFare">₹<%= (searchParams?.fare || Math.ceil((listing.baseFare || listing.price || 0) + ((searchParams?.distance || 0) * (listing.pricePerKm || listing.ratePerKm || 0)))).toLocaleString('en-IN') %></span>
      </div>
    </div>

    <!-- Booking Form -->
    <form id="bookingForm" action="/book/<%= listing._id %>/request" method="POST">
      <div class="section-card">
        <h3><i class="fas fa-pen"></i> Confirm Booking</h3>

        <div class="form-group">
          <label>Pickup Location</label>
          <div class="input-wrap">
            <span class="icon green"><i class="fas fa-circle-dot"></i></span>
            <input type="text" name="booking[pickupLocation]" value="<%= searchParams?.pickup || '' %>" placeholder="Pickup location" required>
          </div>
        </div>

        <div class="form-group">
          <label>Destination</label>
          <div class="input-wrap">
            <span class="icon red"><i class="fas fa-location-dot"></i></span>
            <input type="text" name="booking[destination]" value="<%= searchParams?.destination || '' %>" placeholder="Destination" required>
          </div>
        </div>

        <div class="form-row2">
          <div class="form-group">
            <label>Travel Date</label>
            <div class="input-wrap">
              <span class="icon"><i class="fas fa-calendar"></i></span>
              <input type="date" name="booking[pickupDate]" value="<%= searchParams?.date || '' %>" required>
            </div>
          </div>
          <div class="form-group">
            <label>Pickup Time</label>
            <div class="input-wrap">
              <span class="icon"><i class="fas fa-clock"></i></span>
              <input type="time" name="booking[pickupTime]" value="<%= searchParams?.time || '' %>" required>
            </div>
          </div>
        </div>

        <div class="form-group">
          <label>Passengers</label>
          <div class="input-wrap">
            <span class="icon"><i class="fas fa-users"></i></span>
            <input type="number" name="booking[passengers]" min="1" max="<%= listing.seats || 10 %>" value="<%= searchParams?.passengers || 1 %>" required>
          </div>
        </div>

        <div class="form-group">
          <label>Special Note (Optional)</label>
          <div class="input-wrap">
            <span class="icon"><i class="fas fa-pen"></i></span>
            <textarea name="booking[specialInstructions]" placeholder="Any special requests for the driver..."></textarea>
          </div>
        </div>
      </div>

      <input type="hidden" name="booking[tripType]" value="one-way">
      <input type="hidden" name="booking[distanceKm]" value="<%= searchParams?.distance || 0 %>">
      <input type="hidden" name="booking[estimatedDuration]" value="">
      <input type="hidden" name="booking[estimatedFare]" value="<%= searchParams?.fare || Math.ceil((listing.baseFare || listing.price || 0) + ((searchParams?.distance || 0) * (listing.pricePerKm || listing.ratePerKm || 0))) %>">
      <input type="hidden" name="booking[paymentMethod]" value="cash">
      <% if(searchParams?.pickupLat) { %>
      <input type="hidden" name="booking[pickupLat]" value="<%= searchParams.pickupLat %>">
      <input type="hidden" name="booking[pickupLng]" value="<%= searchParams.pickupLng %>">
      <% } %>
      <% if(searchParams?.destLat) { %>
      <input type="hidden" name="booking[destLat]" value="<%= searchParams.destLat %>">
      <input type="hidden" name="booking[destLng]" value="<%= searchParams.destLng %>">
      <% } %>

      <button type="submit" class="btn-primary" id="submitBtn">
        <i class="fas fa-paper-plane"></i> Send Booking Request
      </button>

      <div style="text-align:center;margin-top:10px;padding-bottom:20px;">
        <span class="status-badge status-pending"><i class="fas fa-clock"></i> Booking stays PENDING until owner confirms</span>
      </div>
    </form>
  </div>
</div>

<script>
// Set default date/time
(function() {
  const d = new Date();
  document.querySelectorAll('input[type="date"]').forEach(el => {
    if (!el.value) {
      el.value = d.toISOString().split('T')[0];
      el.min = d.toISOString().split('T')[0];
    }
  });
  document.querySelectorAll('input[type="time"]').forEach(el => {
    if (!el.value) {
      el.value = String(d.getHours()).padStart(2,'0') + ':' + String(d.getMinutes()+30).padStart(2,'0');
    }
  });
})();

// Form submit
document.getElementById('bookingForm')?.addEventListener('submit', function(e) {
  const btn = document.getElementById('submitBtn');
  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Sending Request...';
});
</script>
</body>
</html>
