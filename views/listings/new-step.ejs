<% layout("/listings/layouts/boilerplate") %>
<div class="step-form-page">
  <div class="step-form-card">
    <h2>Add Your Vehicle</h2>
    <p style="color:var(--text-secondary);font-size:14px;margin:-8px 0 24px">Fill in the details to list your vehicle on RideLocal</p>

    <% if (errorMsg) { %>
      <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i><span><%= errorMsg %></span></div>
    <% } %>

    <!-- Progress -->
    <div class="step-progress">
      <div class="step-bar"><div class="step-bar-fill" id="progressFill" style="width:14.28%"></div></div>
      <div class="step-labels" id="stepLabels">
        <span class="step-lbl active" data-step="1">Vehicle Info</span>
        <span class="step-lbl" data-step="2">Pricing</span>
        <span class="step-lbl" data-step="3">Location</span>
        <span class="step-lbl" data-step="4">Driver</span>
        <span class="step-lbl" data-step="5">Photos</span>
        <span class="step-lbl" data-step="6">Documents</span>
        <span class="step-lbl" data-step="7">Rules</span>
      </div>
    </div>

    <form method="POST" action="/cars/new-step" enctype="multipart/form-data" id="stepForm">

      <!-- ═══ STEP 1: VEHICLE INFO ═══ -->
      <div class="step-panel active" id="step1">
        <div class="step-section">
          <h3>Basic Vehicle Information</h3>
          <div class="input-group">
            <label>Vehicle Title <span class="req">*</span></label>
            <input class="input-field" name="listing[title]" placeholder="e.g. Toyota Innova Crysta" required>
          </div>
          <div class="input-group">
            <label>Description <span class="req">*</span></label>
            <textarea class="input-field" name="listing[description]" rows="3" placeholder="Describe your vehicle features, condition..." required></textarea>
          </div>
          <div class="form-row2">
            <div class="input-group">
              <label>Vehicle Name</label>
              <input class="input-field" name="listing[vehicleName]" placeholder="e.g. Innova Crysta">
            </div>
            <div class="input-group">
              <label>Brand</label>
              <input class="input-field" name="listing[brand]" placeholder="e.g. Toyota">
            </div>
          </div>
          <div class="form-row2">
            <div class="input-group">
              <label>Model</label>
              <input class="input-field" name="listing[model]" placeholder="e.g. VX">
            </div>
            <div class="input-group">
              <label>Year</label>
              <input class="input-field" name="listing[year]" type="number" placeholder="e.g. 2020" min="1900" max="<%= new Date().getFullYear() + 1 %>">
            </div>
          </div>
          <div class="input-group">
            <label>Vehicle Number</label>
            <input class="input-field" name="listing[vehicleNumber]" placeholder="e.g. MH01AB1234">
          </div>
          <div class="form-row2">
            <div class="input-group">
              <label>Vehicle Type</label>
              <input class="input-field" name="listing[vehicleType]" placeholder="e.g. SUV, Sedan, Hatchback">
            </div>
            <div class="input-group">
              <label>Fuel Type</label>
              <select class="input-field" name="listing[fuelType]">
                <option value="petrol">Petrol</option>
                <option value="diesel">Diesel</option>
                <option value="electric">Electric</option>
                <option value="hybrid">Hybrid</option>
                <option value="cng">CNG</option>
                <option value="other">Other</option>
              </select>
            </div>
          </div>
          <div class="form-row2">
            <div class="input-group">
              <label>Transmission</label>
              <select class="input-field" name="listing[transmission]">
                <option value="manual">Manual</option>
                <option value="automatic">Automatic</option>
              </select>
            </div>
            <div class="input-group">
              <label>Seating Capacity</label>
              <select class="input-field" name="listing[seats]">
                <option value="4">4 Seater</option>
                <option value="5">5 Seater</option>
                <option value="6">6 Seater</option>
                <option value="7">7 Seater</option>
                <option value="10">10 Seater</option>
              </select>
            </div>
          </div>
          <div class="form-row3">
            <div class="input-group">
              <label>AC Available</label>
              <select class="input-field" name="listing[acAvailable]">
                <option value="true">Yes</option>
                <option value="false">No</option>
              </select>
            </div>
            <div class="input-group">
              <label>Music System</label>
              <select class="input-field" name="listing[musicSystem]">
                <option value="false">No</option>
                <option value="true">Yes</option>
              </select>
            </div>
            <div class="input-group">
              <label>Luggage</label>
              <select class="input-field" name="listing[luggageCapacity]">
                <option value="small">Small</option>
                <option value="medium">Medium</option>
                <option value="large">Large</option>
                <option value="extra-large">Extra Large</option>
              </select>
            </div>
          </div>
        </div>
        <div class="step-nav"><span></span><button type="button" class="btn btn-primary" onclick="nextStep(1)">Next <i class="fas fa-arrow-right"></i></button></div>
      </div>

      <!-- ═══ STEP 2: PRICING ═══ -->
      <div class="step-panel" id="step2">
        <div class="step-section">
          <h3>Pricing Information</h3>
          <div class="pricing-tip">
            <i class="fas fa-info-circle"></i>
            <div><strong>Pricing Guide:</strong> Base Fare is the minimum charge per trip. Price Per KM is added for each kilometer traveled. Minimum Trip Fare and Night Charge are optional.</div>
          </div>
          <div class="form-row2">
            <div class="input-group">
              <label>Base Fare (₹) <span class="req">*</span></label>
              <input class="input-field" name="listing[baseFare]" placeholder="e.g. 200" type="number" min="0" required>
            </div>
            <div class="input-group">
              <label>Price Per KM (₹) <span class="req">*</span></label>
              <input class="input-field" name="listing[pricePerKm]" placeholder="e.g. 12" type="number" min="0" required>
            </div>
          </div>
          <div class="form-row2">
            <div class="input-group">
              <label>Minimum Trip Fare (₹) <small style="font-weight:400">Optional</small></label>
              <input class="input-field" name="listing[minimumTripFare]" placeholder="e.g. 500" type="number" min="0">
            </div>
            <div class="input-group">
              <label>Night Charge (₹) <small style="font-weight:400">Optional</small></label>
              <input class="input-field" name="listing[nightCharge]" placeholder="e.g. 100" type="number" min="0">
            </div>
          </div>
        </div>
        <div class="step-nav"><button type="button" class="btn btn-ghost" onclick="prevStep(2)"><i class="fas fa-arrow-left"></i> Previous</button><button type="button" class="btn btn-primary" onclick="nextStep(2)">Next <i class="fas fa-arrow-right"></i></button></div>
      </div>

      <!-- ═══ STEP 3: LOCATION ═══ -->
      <div class="step-panel" id="step3">
        <div class="step-section">
          <h3>Location Information</h3>
          <div class="loc-search">
            <input class="input-field" type="text" id="locSearch" placeholder="Search your village/town..." style="flex:1">
            <button type="button" class="btn btn-primary" onclick="searchLocation()"><i class="fas fa-search"></i></button>
          </div>
          <div class="map-wrap"><div id="locMap"></div></div>
          <div class="input-group">
            <label>Location <span class="req">*</span></label>
            <input class="input-field" id="locationField" name="listing[location]" placeholder="Select from map or search" readonly required>
          </div>
          <input type="hidden" id="locationCoords" name="listing[locationCoordinates]">
          <div class="form-row2">
            <div class="input-group"><label>Village</label><input class="input-field" id="villageField" name="listing[village]"></div>
            <div class="input-group"><label>Area</label><input class="input-field" id="areaField" name="listing[area]"></div>
          </div>
          <div class="form-row2">
            <div class="input-group"><label>City</label><input class="input-field" id="cityField" name="listing[city]"></div>
            <div class="input-group"><label>District</label><input class="input-field" id="districtField" name="listing[district]"></div>
          </div>
          <div class="form-row2">
            <div class="input-group"><label>State</label><input class="input-field" id="stateField" name="listing[state]"></div>
            <div class="input-group">
              <label>Service Radius</label>
              <select class="input-field" name="listing[serviceRadius]">
                <option value="">Select radius</option>
                <option value="20">20 KM</option>
                <option value="50">50 KM</option>
                <option value="100">100 KM</option>
                <option value="">Anywhere</option>
              </select>
            </div>
          </div>
        </div>
        <div class="step-nav"><button type="button" class="btn btn-ghost" onclick="prevStep(3)"><i class="fas fa-arrow-left"></i> Previous</button><button type="button" class="btn btn-primary" onclick="nextStep(3)">Next <i class="fas fa-arrow-right"></i></button></div>
      </div>

      <!-- ═══ STEP 4: DRIVER ═══ -->
      <div class="step-panel" id="step4">
        <div class="step-section">
          <h3>Driver Information</h3>
          <div class="input-group">
            <label>Who will drive? <span class="req">*</span></label>
            <div class="radio-group">
              <label class="radio-label"><input type="radio" name="listing[driverType]" value="owner" checked onchange="toggleDriver()"> Owner</label>
              <label class="radio-label"><input type="radio" name="listing[driverType]" value="dedicated-driver" onchange="toggleDriver()"> Dedicated Driver</label>
            </div>
          </div>
          <div class="driver-fields" id="driverFields" style="display:none">
            <div class="form-row2">
              <div class="input-group"><label>Driver Name</label><input class="input-field" name="listing[driverName]" placeholder="Full name"></div>
              <div class="input-group"><label>Experience (Years)</label><input class="input-field" name="listing[driverExperience]" placeholder="e.g. 5" type="number" min="0"></div>
            </div>
            <div class="form-row2">
              <div class="input-group"><label>Phone Number</label><input class="input-field" name="listing[driverPhoneNumber]" placeholder="e.g. 919876543210"></div>
              <div class="input-group"><label>License Number</label><input class="input-field" name="listing[driverLicenseNumber]" placeholder="License number"></div>
            </div>
            <div class="input-group"><label>Driver Photo <small style="font-weight:400">Optional</small></label><input class="input-field" type="file" name="driverPhoto" accept="image/*"></div>
          </div>
        </div>
        <div class="step-nav"><button type="button" class="btn btn-ghost" onclick="prevStep(4)"><i class="fas fa-arrow-left"></i> Previous</button><button type="button" class="btn btn-primary" onclick="nextStep(4)">Next <i class="fas fa-arrow-right"></i></button></div>
      </div>

      <!-- ═══ STEP 5: PHOTOS ═══ -->
      <div class="step-panel" id="step5">
        <div class="step-section">
          <h3>Vehicle Photos</h3>
          <p style="font-size:13px;color:var(--text-secondary);margin:-8px 0 16px">Minimum 4 photos required (Front, Rear, Left, Right). Interior and Dashboard are optional.</p>
          <div class="photo-grid">
            <% ['front','rear','left','right','interior','dashboard'].forEach(type => { %>
              <div class="photo-box" onclick="document.getElementById('<%= type %>Img').click()">
                <input type="file" id="<%= type %>Img" name="<%= type %>Image" accept="image/*" style="display:none" onchange="previewImg(this,'<%= type %>')">
                <div class="photo-preview" id="<%= type %>Preview"><i class="fas fa-camera"></i><span><%= type.charAt(0).toUpperCase() + type.slice(1) %><%= ['front','rear','left','right'].includes(type) ? ' <span class="req">*</span>' : '' %></span></div>
              </div>
            <% }) %>
          </div>
        </div>
        <div class="step-nav"><button type="button" class="btn btn-ghost" onclick="prevStep(5)"><i class="fas fa-arrow-left"></i> Previous</button><button type="button" class="btn btn-primary" onclick="nextStep(5)">Next <i class="fas fa-arrow-right"></i></button></div>
      </div>

      <!-- ═══ STEP 6: DOCUMENTS ═══ -->
      <div class="step-panel" id="step6">
        <div class="step-section">
          <h3>Vehicle Documents</h3>
          <p style="font-size:13px;color:var(--text-secondary);margin:-8px 0 16px">Vehicle RC and Insurance are required. Other documents are optional.</p>
          <% 
            const docs = [
              { name: 'vehicleRC', label: 'Vehicle RC', req: true },
              { name: 'insurance', label: 'Insurance', req: true },
              { name: 'pollutionCertificate', label: 'Pollution Certificate', req: false },
              { name: 'fitnessCertificate', label: 'Fitness Certificate', req: false },
              { name: 'ownerDrivingLicense', label: 'Owner Driving License', req: false },
              { name: 'driverDrivingLicense', label: 'Driver Driving License', req: false },
              { name: 'aadhaar', label: 'Aadhaar Card', req: false }
            ];
          %>
          <% docs.forEach(d => { %>
            <div class="doc-upload">
              <label><%= d.label %><% if(d.req) { %> <span class="req">*</span><% } %></label>
              <input class="input-field" type="file" name="<%= d.name %>" accept="image/*,.pdf" <%= d.req ? 'required' : '' %>>
            </div>
          <% }) %>
        </div>
        <div class="step-nav"><button type="button" class="btn btn-ghost" onclick="prevStep(6)"><i class="fas fa-arrow-left"></i> Previous</button><button type="button" class="btn btn-primary" onclick="nextStep(6)">Next <i class="fas fa-arrow-right"></i></button></div>
      </div>

      <!-- ═══ STEP 7: RULES ═══ -->
      <div class="step-panel" id="step7">
        <div class="step-section">
          <h3>Booking Rules & Payment Settings</h3>
          <div class="form-row2">
            <div class="input-group"><label>Minimum Booking Amount (₹)</label><input class="input-field" name="listing[bookingRules][minimumBookingAmount]" placeholder="e.g. 500" type="number" min="0"></div>
            <div class="input-group"><label>Max Passengers</label><input class="input-field" name="listing[bookingRules][maximumPassengers]" placeholder="e.g. 6" type="number" min="1"></div>
          </div>
          <div class="input-group"><label>Available Trip Types</label><div class="chip-grid"><% ['local','outstation','airport-pickup','railway-pickup','wedding','family-function','temple-visit','tourism','corporate'].forEach(t => { %><label class="chip-check"><input type="checkbox" name="listing[availableTripTypes]" value="<%= t %>"><span><%= t.replace(/-/g,' ').replace(/\b\w/g,c=>c.toUpperCase()) %></span></label><% }) %></div></div>
          <div class="input-group"><label>Booking Preferences</label><div class="chip-grid"><% 
            const prefs = [
              { name: 'listing[bookingRules][smokingAllowed]', label: 'Smoking Allowed' },
              { name: 'listing[bookingRules][petsAllowed]', label: 'Pets Allowed' },
              { name: 'listing[bookingRules][luggageAllowed]', label: 'Luggage Allowed', checked: true },
              { name: 'listing[bookingRules][nightDriving]', label: 'Night Driving', checked: true }
            ];
          %><% prefs.forEach(p => { %><label class="chip-check"><input type="checkbox" name="<%= p.name %>" value="true" <%= p.checked ? 'checked' : '' %>><span><%= p.label %></span></label><% }) %></div></div>
          <div class="input-group"><label>Payment Methods</label><div class="chip-grid"><% ['cash','upi','online'].forEach(m => { %><label class="chip-check"><input type="checkbox" name="listing[paymentMethods]" value="<%= m %>"><span><%= m.charAt(0).toUpperCase() + m.slice(1) %></span></label><% }) %></div></div>
        </div>
        <div class="step-nav"><button type="button" class="btn btn-ghost" onclick="prevStep(7)"><i class="fas fa-arrow-left"></i> Previous</button><button type="submit" class="btn btn-primary btn-lg"><i class="fas fa-check-circle"></i> Submit Listing</button></div>
      </div>

      <div class="auto-save" id="autoSave">Draft saved</div>
    </form>
  </div>
</div>

<script>
let currentStep = 1, totalSteps = 7, map, marker;

function updateProgress() {
  const pct = (currentStep / totalSteps) * 100;
  document.getElementById('progressFill').style.width = pct + '%';
  document.querySelectorAll('.step-lbl').forEach((l, i) => {
    l.classList.toggle('active', i + 1 === currentStep);
    l.classList.toggle('done', i + 1 < currentStep);
  });
}

function showStep(s) {
  document.querySelectorAll('.step-panel').forEach(p => p.classList.remove('active'));
  document.getElementById('step' + s).classList.add('active');
  currentStep = s;
  updateProgress();
  if (s === 3) initMap();
}

function nextStep(cur) {
  const el = document.getElementById('step' + cur);
  const req = el.querySelectorAll('[required]');
  let ok = true;
  req.forEach(f => { if (!f.value.trim()) { f.style.borderColor = '#ef4444'; ok = false; } else f.style.borderColor = ''; });
  if (!ok) return;
  if (cur < totalSteps) { showStep(cur + 1); saveDraft(); }
}

function prevStep(cur) { if (cur > 1) showStep(cur - 1); }

function toggleDriver() {
  document.getElementById('driverFields').style.display =
    document.querySelector('input[name="listing[driverType]"]:checked').value === 'dedicated-driver' ? 'block' : 'none';
}

function previewImg(input, type) {
  const preview = document.getElementById(type + 'Preview');
  if (input.files && input.files[0]) {
    const r = new FileReader();
    r.onload = e => { preview.innerHTML = '<img src="' + e.target.result + '">'; };
    r.readAsDataURL(input.files[0]);
  }
}

function initMap() {
  if (map) return;
  map = L.map('locMap').setView([20.5937, 78.9629], 5);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '© OSM' }).addTo(map);
  map.on('click', e => {
    if (marker) map.removeLayer(marker);
    marker = L.marker(e.latlng).addTo(map);
    document.getElementById('locationCoords').value = JSON.stringify({ type: 'Point', coordinates: [e.latlng.lng, e.latlng.lat] });
    fetch('/cars/reverse-geocode?lat=' + e.latlng.lat + '&lon=' + e.latlng.lng)
      .then(r => r.json()).then(d => {
        if (d.display_name) { document.getElementById('locationField').value = d.display_name; parseAddr(d.display_name); }
      });
  });
}

function searchLocation() {
  const q = document.getElementById('locSearch').value.trim();
  if (!q) return;
  fetch('/cars/geocode?q=' + encodeURIComponent(q)).then(r => r.json()).then(d => {
    if (!d || !d.length) return;
    const r = d[0], lat = parseFloat(r.lat), lon = parseFloat(r.lon);
    if (map) { map.setView([lat, lon], 13); if (marker) map.removeLayer(marker); marker = L.marker([lat, lon]).addTo(map); }
    document.getElementById('locationCoords').value = JSON.stringify({ type: 'Point', coordinates: [lon, lat] });
    document.getElementById('locationField').value = r.display_name;
    parseAddr(r.display_name);
  });
}

function parseAddr(name) {
  const parts = name.split(',');
  if (parts.length >= 3) {
    document.getElementById('villageField').value = parts[0].trim();
    document.getElementById('cityField').value = parts[parts.length - 3].trim();
    document.getElementById('stateField').value = parts[parts.length - 2].trim();
  }
}

function saveDraft() {
  const fd = new FormData(document.getElementById('stepForm'));
  const data = {};
  fd.forEach((v, k) => data[k] = v);
  localStorage.setItem('vehicleDraft', JSON.stringify(data));
  document.getElementById('autoSave').textContent = 'Draft saved ' + new Date().toLocaleTimeString();
}

document.addEventListener('DOMContentLoaded', () => {
  updateProgress();
  const saved = localStorage.getItem('vehicleDraft');
  if (saved) {
    const data = JSON.parse(saved);
    Object.keys(data).forEach(k => {
      const el = document.querySelector('[name="' + k + '"]');
      if (el) el.value = data[k];
    });
  }
});
</script>

<style>
.step-form-page { max-width: 780px; margin: 0 auto; padding: 32px 20px; }
.step-form-card { background: var(--card); border: 1px solid var(--border-light); border-radius: var(--radius-xl); padding: 36px; box-shadow: var(--shadow-md); }
.step-form-card h2 { font-size: 24px; font-weight: 800; }

/* Progress */
.step-progress { margin: 24px 0 32px; }
.step-bar { height: 6px; background: var(--border); border-radius: 3px; overflow: hidden; }
.step-bar-fill { height: 100%; background: var(--gradient); border-radius: 3px; transition: width 0.4s ease; }
.step-labels { display: flex; justify-content: space-between; margin-top: 8px; gap: 4px; }
.step-lbl { font-size: 10px; font-weight: 500; color: var(--text-secondary); text-align: center; flex: 1; white-space: nowrap; transition: color 0.2s; }
.step-lbl.active { color: var(--primary); font-weight: 700; }
.step-lbl.done { color: var(--primary); }

/* Panels */
.step-panel { display: none; animation: stepFade 0.3s ease; }
.step-panel.active { display: block; }
@keyframes stepFade { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
.step-section { background: var(--surface); border-radius: var(--radius-lg); padding: 24px; margin-bottom: 20px; }
.step-section h3 { font-size: 16px; font-weight: 700; margin-bottom: 20px; color: var(--text); }
.step-nav { display: flex; justify-content: space-between; align-items: center; }

/* Pricing tip */
.pricing-tip { display: flex; gap: 12px; padding: 14px; background: var(--primary-50); border-radius: var(--radius-md); margin-bottom: 20px; font-size: 13px; color: var(--primary); line-height: 1.6; }
.pricing-tip i { font-size: 18px; flex-shrink: 0; margin-top: 2px; }

/* Location */
.loc-search { display: flex; gap: 8px; margin-bottom: 12px; }
.map-wrap { height: 280px; border: 2px solid var(--border); border-radius: var(--radius-md); overflow: hidden; margin-bottom: 16px; }
#locMap { width: 100%; height: 100%; }

/* Photo grid */
.photo-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
.photo-box { border: 2px dashed var(--border); border-radius: var(--radius-lg); cursor: pointer; transition: all 0.2s; aspect-ratio: 4/3; }
.photo-box:hover { border-color: var(--primary); background: var(--primary-50); }
.photo-preview { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; color: var(--text-secondary); font-size: 12px; font-weight: 500; }
.photo-preview i { font-size: 24px; color: var(--primary); }
.photo-preview img { width: 100%; height: 100%; object-fit: cover; border-radius: var(--radius-md); }

/* Document upload */
.doc-upload { margin-bottom: 12px; }
.doc-upload label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; }
.doc-upload input { }

/* Chip checkboxes */
.chip-grid { display: flex; flex-wrap: wrap; gap: 8px; }
.chip-check { cursor: pointer; }
.chip-check input { display: none; }
.chip-check span { display: inline-block; padding: 8px 16px; border: 1.5px solid var(--border); border-radius: var(--radius-full); font-size: 13px; font-weight: 500; color: var(--text-secondary); transition: all 0.15s; }
.chip-check input:checked + span { background: var(--primary); color: #fff; border-color: var(--primary); }
.chip-check:hover span { border-color: var(--primary); }

/* Driver */
.driver-fields { padding-top: 12px; }
.radio-group { display: flex; gap: 24px; margin-top: 4px; }
.radio-label { display: flex; align-items: center; gap: 8px; font-size: 14px; cursor: pointer; }
.radio-label input[type="radio"] { accent-color: var(--primary); width: 16px; height: 16px; }

/* Form row helpers */
.form-row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.form-row3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 14px; }
