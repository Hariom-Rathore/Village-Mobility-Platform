<% layout("/listings/layouts/boilerplate") %>
<div class="form-page">
  <div class="form-card fade-in">
    <a href="/cars" class="back-link"><i class="fas fa-arrow-left"></i> Back to Vehicles</a>
    <h2>Add a New Vehicle</h2>
    <% if (errorMsg) { %>
      <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i><span><%= errorMsg %></span></div>
    <% } %>
    <form method="POST" action="/cars" enctype="multipart/form-data">
      <div class="input-group">
        <label>Vehicle Title</label>
        <input class="input-field" name="listing[title]" placeholder="e.g. Toyota Innova Crysta" value="<%= listing?.title || '' %>" required>
      </div>
      <div class="input-group">
        <label>Description</label>
        <textarea class="input-field" name="listing[description]" placeholder="Describe your vehicle" rows="3" required><%= listing?.description || '' %></textarea>
      </div>
      <div class="form-row2">
        <div class="input-group">
          <label>Price Per Day (₹)</label>
          <input class="input-field" name="listing[price]" placeholder="e.g. 5000" value="<%= listing?.price ?? '' %>">
        </div>
        <div class="input-group">
          <label>Rate Per Km (₹)</label>
          <input class="input-field" name="listing[ratePerKm]" placeholder="e.g. 20" value="<%= listing?.ratePerKm ?? '' %>">
        </div>
      </div>
      <div class="input-group">
        <label>Car Type</label>
        <select class="input-field" name="listing[carType]">
          <option value="other" <%= listing?.carType === 'other' ? 'selected' : '' %>>Other</option>
          <option value="electric" <%= listing?.carType === 'electric' ? 'selected' : '' %>>Electric</option>
          <option value="petrol" <%= listing?.carType === 'petrol' ? 'selected' : '' %>>Petrol</option>
          <option value="diesel" <%= listing?.carType === 'diesel' ? 'selected' : '' %>>Diesel</option>
          <option value="hybrid" <%= listing?.carType === 'hybrid' ? 'selected' : '' %>>Hybrid</option>
        </select>
      </div>
      <div class="form-row2">
        <div class="input-group">
          <label>Seating Capacity</label>
          <select class="input-field" name="listing[seats]">
            <option value="4" <%= Number(listing?.seats) === 4 ? 'selected' : '' %>>4 Seater</option>
            <option value="6" <%= Number(listing?.seats) === 6 ? 'selected' : '' %>>6 Seater</option>
            <option value="10" <%= Number(listing?.seats) === 10 ? 'selected' : '' %>>10 Seater</option>
          </select>
        </div>
        <div class="input-group">
          <label>Country</label>
          <input class="input-field" name="listing[country]" placeholder="India" value="<%= listing?.country || 'India' %>" required>
        </div>
      </div>
      <div class="input-group">
        <label>Location</label>
        <input class="input-field" name="listing[location]" placeholder="Enter location" value="<%= listing?.location || '' %>" required>
      </div>
      <div class="input-group">
        <label>WhatsApp Number</label>
        <input class="input-field" name="listing[whatsappNumber]" placeholder="919876543210" value="<%= listing?.whatsappNumber || '' %>" required>
      </div>
      <div class="input-group">
        <label>Upload Image</label>
        <input class="input-field" type="file" name="listing[image]" accept="image/*">
      </div>
      <button type="submit" class="btn btn-primary btn-lg btn-block">Add Vehicle</button>
    </form>
  </div>
</div>

<style>
.form-page { max-width: 640px; margin: 0 auto; padding: 32px 20px; }
.form-card { background: var(--card); border: 1px solid var(--border-light); border-radius: var(--radius-xl); padding: 36px; box-shadow: var(--shadow-md); }
.form-card h2 { font-size: 24px; font-weight: 800; margin-bottom: 24px; }
.back-link { display: inline-flex; align-items: center; gap: 6px; font-size: 14px; color: var(--text-secondary); text-decoration: none; margin-bottom: 16px; }
.back-link:hover { color: var(--text); }
.form-row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
@media (max-width: 640px) { .form-row2 { grid-template-columns: 1fr; } }
</style>
