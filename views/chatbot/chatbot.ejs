<% layout("/listings/layouts/boilerplate") %>
<div class="chatbot-page fade-in">
  <div class="card" style="max-width:720px;margin:0 auto">
    <div class="card-body" style="padding:0">
      <div class="chatbot-header">
        <i class="fas fa-robot"></i>
        <div><h3>AI Assistant</h3><p>Ask me anything about trips, vehicles, or the platform</p></div>
      </div>
      <div id="chatbox" class="chatbox"></div>
      <form id="chatForm" class="chat-input-wrap">
        <input type="text" id="userInput" placeholder="Type your message..." required>
        <button type="submit"><i class="fas fa-paper-plane"></i></button>
      </form>
    </div>
  </div>
</div>

<style>
.chatbot-page { max-width: 720px; margin: 0 auto; padding: 32px 20px; }
.chatbot-header { display: flex; align-items: center; gap: 14px; padding: 20px 24px; border-bottom: 1px solid var(--border-light); background: linear-gradient(135deg, var(--primary-50), #fff); border-radius: var(--radius-lg) var(--radius-lg) 0 0; }
.chatbot-header i { font-size: 32px; color: var(--primary); }
.chatbot-header h3 { font-size: 18px; font-weight: 700; margin: 0; }
.chatbot-header p { font-size: 13px; color: var(--text-secondary); margin: 2px 0 0; }
.chatbox { height: 400px; overflow-y: auto; padding: 16px 24px; display: flex; flex-direction: column; gap: 10px; }
.chat-message { padding: 12px 16px; border-radius: var(--radius-lg); max-width: 80%; word-wrap: break-word; font-size: 14px; line-height: 1.5; }
.chat-message strong { display: block; margin-bottom: 4px; font-size: 12px; }
.user-message { background: var(--primary); color: #fff; align-self: flex-end; border-bottom-right-radius: 4px; }
.bot-message { background: var(--surface); color: var(--text); align-self: flex-start; border-bottom-left-radius: 4px; }
.chat-input-wrap { display: flex; border-top: 1px solid var(--border-light); padding: 12px 16px; }
.chat-input-wrap input { flex: 1; border: none; background: var(--surface); border-radius: var(--radius-full); padding: 12px 18px; font-size: 14px; outline: none; }
.chat-input-wrap input:focus { box-shadow: 0 0 0 2px var(--primary-50); }
.chat-input-wrap button { width: 44px; height: 44px; border: none; background: var(--primary); color: #fff; border-radius: 50%; margin-left: 8px; cursor: pointer; transition: all 0.15s; }
.chat-input-wrap button:hover { background: var(--primary-dark); transform: scale(1.05); }
</style>

<script>
document.getElementById("chatForm").addEventListener("submit", async (e) => {
  e.preventDefault();
  const input = document.getElementById("userInput");
  const msg = input.value.trim();
  if (!msg) return;
  const chatbox = document.getElementById("chatbox");
  const addMsg = (cls, label, text) => {
    const d = document.createElement("div");
    d.className = "chat-message " + cls;
    d.innerHTML = `<strong>${label}</strong>${text}`;
    chatbox.appendChild(d);
    chatbox.scrollTop = chatbox.scrollHeight;
  };
  addMsg("user-message", "You", msg);
  input.value = "";
  try {
    const r = await fetch("/chatbot/send", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ message: msg }) });
    const d = await r.json();
    addMsg("bot-message", d.success ? "Assistant" : "Bot", d.success ? d.reply : "Sorry, I encountered an error.");
  } catch { addMsg("bot-message", "Bot", "Network error. Please try again."); }
});
</script>
