<% layout("/listings/layouts/boilerplate") %>

<style>
.my-trips {
    padding: 20px;
    max-width: 1200px;
    margin: 0 auto;
}

.page-header {
    margin-bottom: 24px;
}

.page-title {
    font-size: 28px;
    font-weight: 700;
    color: #333;
    margin-bottom: 8px;
}

.page-subtitle {
    color: #666;
    font-size: 14px;
}

.tabs-container {
    background: white;
    border-radius: 12px;
    padding: 16px;
    margin-bottom: 24px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}

.tabs {
    display: flex;
    gap: 8px;
    border-bottom: 2px solid #f3f4f6;
    padding-bottom: 12px;
}

.tab {
    padding: 10px 20px;
    border: none;
    background: none;
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
    color: #666;
    border-radius: 8px;
    transition: all 0.3s;
}

.tab:hover {
    background: #f3f4f6;
}

.tab.active {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
}

.trips-grid {
    display: grid;
    gap: 16px;
}

.trip-card {
    background: white;
    border-radius: 12px;
    padding: 20px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    transition: all 0.3s;
}

.trip-card:hover {
    box-shadow: 0 4px 16px rgba(0,0,0,0.1);
}

.trip-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
}

.trip-vehicle {
    display: flex;
    align-items: center;
    gap: 12px;
}

.trip-vehicle-image {
    width: 60px;
    height: 60px;
    border-radius: 8px;
    object-fit: cover;
}

.trip-vehicle-info h4 {
    font-size: 16px;
    font-weight: 700;
    margin: 0 0 4px 0;
    color: #333;
}

.trip-vehicle-info p {
    font-size: 13px;
    color: #666;
    margin: 0;
}

.status-badge {
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
}

.status-pending {
    background: #fef3c7;
    color: #92400e;
}

.status-accepted {
    background: #d1fae5;
    color: #065f46;
}

.status-completed {
    background: #dbeafe;
    color: #1e40af;
}

.status-cancelled {
    background: #fee2e2;
    color: #991b1b;
}

.status-rejected {
    background: #f3f4f6;
    color: #4b5563;
}

.trip-details {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin-bottom: 16px;
}

.trip-detail {
    display: flex;
    flex-direction: column;
}

.trip-detail label {
    font-size: 12px;
    color: #999;
    margin-bottom: 4px;
}

.trip-detail span {
    font-size: 14px;
    font-weight: 600;
    color: #333;
}

.trip-route {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    padding: 12px;
    background: #f9fafb;
    border-radius: 8px;
}

.route-point {
    flex: 1;
}

.route-point label {
    font-size: 12px;
    color: #999;
    margin-bottom: 4px;
}

.route-point span {
    font-size: 14px;
    font-weight: 600;
    color: #333;
}

.route-arrow {
    color: #667eea;
    font-size: 20px;
}

.trip-price {
    font-size: 24px;
    font-weight: 700;
    color: #667eea;
    margin-bottom: 16px;
}

.trip-actions {
    display: flex;
    gap: 12px;
}

.btn-action {
    padding: 10px 20px;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s;
}

.btn-primary {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
}

.btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
}

.btn-secondary {
    background: #f3f4f6;
    color: #333;
}

.btn-secondary:hover {
    background: #e5e7eb;
}

.btn-danger {
    background: #fee2e2;
    color: #991b1b;
}

.btn-danger:hover {
    background: #fecaca;
}

.empty-state {
    text-align: center;
    padding: 60px 20px;
    color: #999;
}

.empty-state i {
    font-size: 48px;
    margin-bottom: 16px;
}

.loading-skeleton {
    background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
    background-size: 200% 100%;
    animation: loading 1.5s infinite;
    border-radius: 8px;
}

@keyframes loading {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
}

@media (max-width: 768px) {
    .my-trips {
        padding: 12px;
    }
    
    .tabs {
        overflow-x: auto;
        padding-bottom: 8px;
    }
    
    .tab {
        white-space: nowrap;
    }
    
    .trip-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
    }
    
    .trip-details {
        grid-template-columns: 1fr;
    }
    
    .trip-route {
        flex-direction: column;
        align-items: flex-start;
    }
    
    .route-arrow {
        transform: rotate(90deg);
    }
    
    .trip-actions {
        flex-direction: column;
    }
    
    .btn-action {
        width: 100%;
    }
}
</style>

<div class="my-trips">
    <div class="page-header">
        <h1 class="page-title">My Trips</h1>
        <p class="page-subtitle">View and manage your bookings</p>
    </div>

    <!-- Tabs -->
    <div class="tabs-container">
        <div class="tabs">
            <button class="tab active" onclick="switchTab('upcoming')">Upcoming</button>
            <button class="tab" onclick="switchTab('completed')">Completed</button>
            <button class="tab" onclick="switchTab('cancelled')">Cancelled</button>
        </div>
    </div>

    <!-- Trips Container -->
    <div id="tripsContainer" class="trips-grid">
        <!-- Trips will be loaded here -->
    </div>
    
    <div id="emptyState" class="empty-state" style="display: none;">
        <i class="fas fa-route"></i>
        <h3>No trips found</h3>
        <p>You don't have any trips in this category</p>
    </div>
    
    <div id="loadingState" class="empty-state" style="display: none;">
        <i class="fas fa-spinner fa-spin"></i>
        <h3>Loading trips...</h3>
    </div>
</div>

<script>
let currentTab = 'upcoming';

async function loadTrips(tab) {
    const container = document.getElementById('tripsContainer');
    const emptyState = document.getElementById('emptyState');
    const loadingState = document.getElementById('loadingState');
    
    loadingState.style.display = 'block';
    container.innerHTML = '';
    
    try {
        let status = '';
        if (tab === 'upcoming') {
            status = 'PENDING,ACCEPTED,CONFIRMED';
        } else if (tab === 'completed') {
            status = 'COMPLETED';
        } else if (tab === 'cancelled') {
            status = 'CANCELLED,REJECTED';
        }
        
        const response = await fetch(`/bookings/user?status=${status}`);
        const data = await response.json();
        
        loadingState.style.display = 'none';
        
        if (!data.success || !data.bookings || data.bookings.length === 0) {
            emptyState.style.display = 'block';
            return;
        }
        
        data.bookings.forEach(booking => {
            const tripCard = createTripCard(booking);
            container.appendChild(tripCard);
        });
    } catch (error) {
        console.error('Error loading trips:', error);
        loadingState.style.display = 'none';
        emptyState.style.display = 'block';
    }
}

function createTripCard(booking) {
    const card = document.createElement('div');
    card.className = 'trip-card';
    
    const vehicle = booking.vehicleId || {};
    const owner = booking.ownerId || {};
    
    const vehicleName = vehicle.vehicleName || vehicle.title || 'Vehicle';
    const vehicleImage = vehicle.images && vehicle.images.length > 0 
        ? vehicle.images[0].url 
        : (vehicle.image?.url || 'https://images.pexels.com/photos/11129937/pexels-photo-11129937.jpeg');
    
    const statusClass = getStatusClass(booking.bookingStatus);
    const statusText = formatStatus(booking.bookingStatus);
    
    card.innerHTML = `
        <div class="trip-header">
            <div class="trip-vehicle">
                <img src="${vehicleImage}" alt="${vehicleName}" class="trip-vehicle-image" onerror="this.src='https://images.pexels.com/photos/11129937/pexels-photo-11129937.jpeg'">
                <div class="trip-vehicle-info">
                    <h4>${vehicleName}</h4>
                    <p>Owner: ${owner.username || 'Vehicle Owner'}</p>
                </div>
            </div>
            <span class="status-badge ${statusClass}">${statusText}</span>
        </div>
        
        <div class="trip-route">
            <div class="route-point">
                <label><i class="fas fa-map-marker-alt"></i> Pickup</label>
                <span>${booking.pickup || 'Not specified'}</span>
            </div>
            <div class="route-arrow"><i class="fas fa-arrow-right"></i></div>
            <div class="route-point">
                <label><i class="fas fa-flag-checkered"></i> Destination</label>
                <span>${booking.destination || 'Not specified'}</span>
            </div>
        </div>
        
        <div class="trip-details">
            <div class="trip-detail">
                <label>Date & Time</label>
                <span>${formatDateTime(booking.pickupDate, booking.pickupTime)}</span>
            </div>
            <div class="trip-detail">
                <label>Passengers</label>
                <span>${booking.passengers || 'N/A'}</span>
            </div>
            <div class="trip-detail">
                <label>Trip Type</label>
                <span>${formatTripType(booking.tripType)}</span>
            </div>
            <div class="trip-detail">
                <label>Distance</label>
                <span>${booking.distanceKm || 'N/A'} km</span>
            </div>
        </div>
        
        <div class="trip-price">
            ₹${booking.totalPrice || booking.estimatedFare || 0}
        </div>
        
        ${getTripActions(booking)}
    `;
    
    return card;
}

function getTripActions(booking) {
    const status = booking.bookingStatus;
    
    if (status === 'PENDING' || status === 'PENDING_OWNER_APPROVAL') {
        return `
            <div class="trip-actions">
                <button class="btn-action btn-danger" onclick="cancelTrip('${booking._id}')">Cancel Request</button>
            </div>
        `;
    }
    
    if (status === 'COUNTER_OFFERED') {
        return `
            <div class="trip-actions">
                <button class="btn-action btn-primary" onclick="acceptCounterOffer('${booking._id}')">Accept Offer (₹${booking.counterOffer?.totalFare || 0})</button>
                <button class="btn-action btn-danger" onclick="rejectCounterOffer('${booking._id}')">Reject Offer</button>
            </div>
        `;
    }
    
    if (status === 'ACCEPTED' || status === 'CONFIRMED') {
        return `
            <div class="trip-actions">
                <button class="btn-action btn-secondary" onclick="viewDetails('${booking._id}')">View Details</button>
                <button class="btn-action btn-danger" onclick="cancelTrip('${booking._id}')">Cancel Trip</button>
            </div>
        `;
    }
    
    if (status === 'COMPLETED') {
        return `
            <div class="trip-actions">
                <button class="btn-action btn-primary" onclick="bookAgain('${booking.vehicleId}')">Book Again</button>
                <button class="btn-action btn-secondary" onclick="leaveReview('${booking._id}')">Leave Review</button>
            </div>
        `;
    }
    
    return '';
}

function getStatusClass(status) {
    const statusMap = {
        'PENDING': 'status-pending',
        'PENDING_OWNER_APPROVAL': 'status-pending',
        'ACCEPTED': 'status-accepted',
        'CONFIRMED': 'status-accepted',
        'COMPLETED': 'status-completed',
        'CANCELLED': 'status-cancelled',
        'REJECTED': 'status-rejected',
        'COUNTER_OFFERED': 'status-pending'
    };
    return statusMap[status] || 'status-pending';
}

function formatStatus(status) {
    const statusMap = {
        'PENDING': 'Pending',
        'PENDING_OWNER_APPROVAL': 'Pending',
        'ACCEPTED': 'Accepted',
        'CONFIRMED': 'Confirmed',
        'COMPLETED': 'Completed',
        'CANCELLED': 'Cancelled',
        'REJECTED': 'Rejected',
        'COUNTER_OFFERED': 'Counter Offer'
    };
    return statusMap[status] || status;
}

function formatDateTime(date, time) {
    if (!date) return 'Not specified';
    const dateObj = new Date(date);
    const dateStr = dateObj.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
    const timeStr = time || 'Not specified';
    return `${dateStr} at ${timeStr}`;
}

function formatTripType(type) {
    if (!type) return 'Not specified';
    return type.split('-').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');
}

function switchTab(tab) {
    currentTab = tab;
    
    // Update tab styles
    document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
    event.target.classList.add('active');
    
    // Load trips for the selected tab
    loadTrips(tab);
}

async function cancelTrip(bookingId) {
    if (!confirm('Are you sure you want to cancel this trip?')) return;
    
    try {
        const response = await fetch(`/bookings/${bookingId}`, {
            method: 'DELETE',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ reason: 'Customer cancelled' })
        });
        
        const data = await response.json();
        
        if (data.success) {
            alert('Trip cancelled successfully');
            loadTrips(currentTab);
        } else {
            alert('Failed to cancel trip: ' + data.error);
        }
    } catch (error) {
        console.error('Error cancelling trip:', error);
        alert('Failed to cancel trip');
    }
}

async function acceptCounterOffer(bookingId) {
    try {
        const response = await fetch(`/bookings/counter-offer/${bookingId}/respond`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ action: 'accept' })
        });
        
        const data = await response.json();
        
        if (data.success) {
            alert('Counter offer accepted! Your trip is confirmed.');
            loadTrips(currentTab);
        } else {
            alert('Failed to accept counter offer: ' + data.error);
        }
    } catch (error) {
        console.error('Error accepting counter offer:', error);
        alert('Failed to accept counter offer');
    }
}

async function rejectCounterOffer(bookingId) {
    if (!confirm('Are you sure you want to reject this counter offer?')) return;
    
    try {
        const response = await fetch(`/bookings/counter-offer/${bookingId}/respond`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ action: 'reject' })
        });
        
        const data = await response.json();
        
        if (data.success) {
            alert('Counter offer rejected.');
            loadTrips(currentTab);
        } else {
            alert('Failed to reject counter offer: ' + data.error);
        }
    } catch (error) {
        console.error('Error rejecting counter offer:', error);
        alert('Failed to reject counter offer');
    }
}

function viewDetails(bookingId) {
    // Navigate to booking details page
    window.location.href = `/bookings/${bookingId}`;
}

function bookAgain(vehicleId) {
    // Navigate to booking page with this vehicle
    window.location.href = `/cars/book/${vehicleId}`;
}

function leaveReview(bookingId) {
    // Navigate to review page
    window.location.href = `/cars/${bookingId}/reviews`;
}

// Load upcoming trips on page load
document.addEventListener('DOMContentLoaded', () => {
    loadTrips('upcoming');
});
</script>
