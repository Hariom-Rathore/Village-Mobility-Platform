    <div class="fp-section">
      <h4>More Options</h4>
      <div class="fp-row">
        <label>AC Only</label>
        <div class="toggle" id="filterAC" onclick="toggleFilter(this,'ac')"></div>
      </div>
      <div class="fp-row">
        <label>4★ &amp; Above</label>
        <div class="toggle" id="filterRating" onclick="toggleFilter(this,'rating')"></div>
      </div>
      <div class="fp-row">
        <label>Verified Owners Only</label>
        <div class="toggle" id="filterVerified" onclick="toggleFilter(this,'verified')"></div>
      </div>
