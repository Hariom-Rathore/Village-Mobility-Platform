    </div>

    <!-- Results Area -->
    <div class="results-area" id="resultsArea">

      <!-- Map -->
      <div class="map-container" id="mapContainer">
        <div id="searchMap"></div>
        <div class="map-overlay-info" id="mapOverlay">
          <div class="route" id="mapRoute">Searching...</div>
          <div class="dist" id="mapDist"><i class="fas fa-road"></i> <span></span></div>
        </div>
      </div>

      <!-- Bottom Sheet -->
      <div class="bottom-sheet">
        <div class="handle"></div>
        <div class="sheet-header">
          <h3 id="resultsTitle">Available Vehicles</h3>
          <span class="count" id="resultsCount">0 found</span>
        </div>

        <!-- Filter Chips -->
        <div class="filter-chips" id="filterChips">
          <button class="filter-chip active" data-sort="all" onclick="applySort('all')">All</button>
          <button class="filter-chip" data-sort="nearest" onclick="applySort('nearest')"><i class="fas fa-location-arrow"></i> Nearest</button>
          <button class="filter-chip" data-sort="rating" onclick="applySort('rating')"><i class="fas fa-star"></i> Best Rated</button>
          <button class="filter-chip" data-sort="price_low" onclick="applySort('price_low')"><i class="fas fa-rupee-sign"></i> Lowest Fare</button>
          <button class="filter-chip" data-sort="suv" onclick="applyVehicleFilter('SUV')">SUV</button>
          <button class="filter-chip" data-sort="sedan" onclick="applyVehicleFilter('Sedan')">Sedan</button>
          <button class="filter-chip" data-sort="traveller" onclick="applyVehicleFilter('Traveller')">Traveller</button>
          <button class="filter-chip" data-sort="luxury" onclick="applyVehicleFilter('Luxury')">Luxury</button>
          <button class="filter-chip filter-chip more" id="filterMoreBtn" onclick="openFilterModal()">
            <i class="fas fa-sliders"></i> Filters
            <span class="badge-count" id="filterBadgeCount">0</span>
          </button>
