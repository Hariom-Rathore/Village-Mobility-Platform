        <!-- Vehicle List -->
        <div class="vehicle-list" id="vehicleList">
          <!-- Skeletons shown during load, then populated -->
        </div>
      </div>
    </div>

  </div>

  <!-- Bottom Navigation -->
  <nav class="bottom-nav">
    <a class="nav-item active" href="/customers/home">
      <i class="fas fa-home"></i><span>Home</span>
    </a>
    <a class="nav-item" href="/customers/my-trips">
      <i class="fas fa-route"></i><span>My Trips</span>
    </a>
    <a class="nav-item" href="/notifications">
