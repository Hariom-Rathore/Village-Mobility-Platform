<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0,maximum-scale=1.0,user-scalable=no">
<title>RideLocal - Book Local Trips</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<style>
:root{--primary:#2563eb;--primary-dark:#1d4ed8;--primary-light:#dbeafe;--bg:#f0f4f9;--card:#fff;--text:#0f172a;--text2:#475569;--text3:#94a3b8;--border:#e2e8f0;--shadow:0 2px 16px rgba(0,0,0,0.06);--radius:16px;--radius-sm:12px;}
*{margin:0;padding:0;box-sizing:border-box;}
html,body{height:100%;overflow:hidden;}
body{font-family:'Inter',-apple-system,sans-serif;background:var(--bg);color:var(--text);-webkit-font-smoothing:antialiased;}

/* Mobile Container */
.app{max-width:480px;margin:0 auto;height:100vh;display:flex;flex-direction:column;background:var(--card);position:relative;overflow:hidden;}

/* ── Header ── */
.header{display:flex;align-items:center;justify-content:space-between;padding:12px 16px;background:var(--card);position:relative;z-index:10;flex-shrink:0;border-bottom:1px solid rgba(0,0,0,0.04);}
.header-logo{display:flex;align-items:center;gap:8px;}
.header-logo .icon{width:36px;height:36px;background:linear-gradient(135deg,var(--primary),#7c3aed);border-radius:10px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:16px;}
.header-logo span{font-size:18px;font-weight:800;color:var(--text);letter-spacing:-0.5px;}
.header-actions{display:flex;align-items:center;gap:8px;}
.notif-btn{width:40px;height:40px;border:none;background:var(--bg);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:16px;color:var(--text2);cursor:pointer;position:relative;transition:all .15s;}
.notif-btn:active{transform:scale(0.92);}
.notif-badge{position:absolute;top:4px;right:4px;width:18px;height:18px;background:#ef4444;border-radius:50%;color:#fff;font-size:9px;font-weight:700;display:none;align-items:center;justify-content:center;border:2px solid var(--card);}
.avatar-btn{width:40px;height:40px;border:none;border-radius:50%;background:linear-gradient(135deg,var(--primary),#7c3aed);color:#fff;font-size:16px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .15s;overflow:hidden;}
.avatar-btn img{width:100%;height:100%;object-fit:cover;}

/* ── Scrollable Content ── */
.scroll-area{flex:1;overflow-y:auto;overflow-x:hidden;-webkit-overflow-scrolling:touch;}
.scroll-area::-webkit-scrollbar{display:none;}

/* ── Welcome Section ── */
.welcome{padding:20px 20px 8px;}
.welcome h1{font-size:24px;font-weight:800;letter-spacing:-0.5px;line-height:1.2;}
.welcome h1 span{background:linear-gradient(135deg,var(--primary),#7c3aed);-webkit-background-clip:text;-webkit-text-fill-color:transparent;}
.welcome p{font-size:14px;color:var(--text3);margin-top:4px;}

/* ── Quick Info Strip ── */
.quick-strip{display:flex;gap:6px;padding:12px 20px 0;overflow-x:auto;flex-shrink:0;}
.quick-strip::-webkit-scrollbar{display:none;}
.quick-chip{white-space:nowrap;padding:8px 14px;border-radius:20px;font-size:12px;font-weight:600;border:none;cursor:pointer;transition:all .15s;background:var(--bg);color:var(--text2);flex-shrink:0;}
.quick-chip i{margin-right:4px;}
.quick-chip.active{background:var(--primary);color:#fff;}
.quick-chip:active{transform:scale(0.95);}

/* ── Search Card ── */
.search-section{padding:12px 20px 20px;}
.search-card{background:var(--card);border-radius:20px;padding:20px;box-shadow:0 4px 24px rgba(0,0,0,0.06);border:1px solid rgba(0,0,0,0.04);}
.search-card .title{font-size:15px;font-weight:700;margin-bottom:16px;display:flex;align-items:center;gap:8px;}
.search-card .title i{color:var(--primary);}
.form-group{margin-bottom:12px;}
.form-group:last-of-type{margin-bottom:16px;}
.form-group label{display:block;font-size:11px;font-weight:600;color:var(--text3);margin-bottom:4px;text-transform:uppercase;letter-spacing:0.5px;}
.input-wrap{display:flex;align-items:center;background:var(--bg);border:2px solid transparent;border-radius:var(--radius-sm);padding:0 14px;transition:all .2s;min-height:48px;}
.input-wrap:focus-within{border-color:var(--primary);background:var(--card);box-shadow:0 0 0 4px rgba(37,99,235,0.08);}
.input-wrap .icon{color:var(--text3);font-size:14px;width:22px;text-align:center;flex-shrink:0;}
.input-wrap .icon.green{color:#10b981;}
.input-wrap .icon.red{color:#ef4444;}
.input-wrap input,.input-wrap select{flex:1;border:none;background:transparent;padding:12px 8px;font-size:14px;outline:none;font-family:inherit;color:var(--text);min-width:0;}
.input-wrap input::placeholder{color:var(--text3);}
.input-wrap select{appearance:none;-webkit-appearance:none;cursor:pointer;}
.input-wrap .chevron{color:var(--text3);font-size:10px;pointer-events:none;}
.form-row2{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
.pax-control{display:flex;align-items:center;gap:8px;}
.pax-control button{width:32px;height:32px;border:none;border-radius:50%;background:var(--bg);color:var(--text2);font-size:16px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .15s;flex-shrink:0;}
.pax-control button:active{transform:scale(0.9);}
.pax-control span{font-size:16px;font-weight:700;min-width:24px;text-align:center;}

/* Current Location Button */
.current-loc-btn{display:flex;align-items:center;gap:6px;padding:6px 12px;margin-top:4px;border:none;background:var(--primary-light);color:var(--primary);border-radius:8px;font-size:11px;font-weight:600;cursor:pointer;transition:all .15s;}
.current-loc-btn i{font-size:12px;}
.current-loc-btn:active{opacity:0.7;}
.current-loc-btn:disabled{opacity:0.5;cursor:not-allowed;}
.loc-loading{display:none;align-items:center;gap:6px;padding:6px 12px;margin-top:4px;font-size:11px;color:var(--text3);}
.loc-loading.show{display:flex;}

.btn-search{width:100%;background:linear-gradient(135deg,var(--primary),#7c3aed);color:#fff;border:none;border-radius:14px;padding:16px;font-size:16px;font-weight:700;cursor:pointer;transition:all .2s;display:flex;align-items:center;justify-content:center;gap:8px;}
.btn-search:active{transform:scale(0.97);opacity:0.9;}
.btn-search:disabled{opacity:0.5;cursor:not-allowed;transform:none;}
.btn-search i{font-size:16px;}

/* ── Autocomplete Dropdown ── */
.autocomplete-dropdown{position:absolute;left:14px;right:14px;top:100%;background:var(--card);border-radius:var(--radius-sm);box-shadow:0 8px 32px rgba(0,0,0,0.12);max-height:200px;overflow-y:auto;z-index:100;display:none;border:1px solid var(--border);}
.autocomplete-dropdown.show{display:block;}
.autocomplete-item{padding:12px 14px;cursor:pointer;display:flex;align-items:center;gap:10px;border-bottom:1px solid var(--border);transition:background .1s;}
.autocomplete-item:last-child{border-bottom:none;}
.autocomplete-item:hover,.autocomplete-item.highlighted{background:var(--bg);}
.autocomplete-item .loc-icon{width:32px;height:32px;border-radius:50%;background:var(--bg);display:flex;align-items:center;justify-content:center;color:var(--text3);font-size:12px;flex-shrink:0;}
.autocomplete-item .loc-text{flex:1;min-width:0;}
.autocomplete-item .loc-primary{font-size:13px;font-weight:600;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.autocomplete-item .loc-secondary{font-size:11px;color:var(--text3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}

/* ── Results Area ── */
.results-area{display:none;flex-direction:column;flex:1;position:relative;}
.results-area.show{display:flex;}

/* Map Container */
.map-container{width:100%;height:240px;flex-shrink:0;position:relative;background:#e8eef5;overflow:hidden;}
.map-container #searchMap{width:100%;height:100%;}
.map-overlay-info{position:absolute;top:12px;left:12px;background:rgba(255,255,255,0.95);backdrop-filter:blur(10px);border-radius:12px;padding:10px 14px;box-shadow:0 2px 12px rgba(0,0,0,0.1);z-index:1000;font-size:12px;max-width:200px;}
.map-overlay-info .route{font-weight:600;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.map-overlay-info .dist{color:var(--text3);font-size:11px;margin-top:2px;}
.map-overlay-info .dist i{color:var(--primary);margin-right:2px;}

/* Bottom Sheet */
.bottom-sheet{flex:1;display:flex;flex-direction:column;background:var(--card);border-radius:20px 20px 0 0;margin-top:-16px;position:relative;z-index:5;box-shadow:0 -4px 24px rgba(0,0,0,0.06);}
.bottom-sheet .handle{width:36px;height:4px;border-radius:4px;background:#d1d5db;margin:10px auto 6px;flex-shrink:0;}
.sheet-header{display:flex;align-items:center;justify-content:space-between;padding:4px 20px 8px;flex-shrink:0;}
.sheet-header h3{font-size:16px;font-weight:700;}
.sheet-header .count{font-size:12px;color:var(--text3);background:var(--bg);padding:4px 10px;border-radius:20px;}

/* Filter Chips */
.filter-chips{display:flex;gap:6px;padding:0 20px 10px;overflow-x:auto;flex-shrink:0;flex-wrap:nowrap;-webkit-overflow-scrolling:touch;}
.filter-chips::-webkit-scrollbar{display:none;}
.filter-chip{white-space:nowrap;padding:7px 14px;border-radius:20px;font-size:12px;font-weight:500;border:1.5px solid var(--border);background:var(--card);color:var(--text2);cursor:pointer;transition:all .15s;flex-shrink:0;}
.filter-chip:active{transform:scale(0.95);}
.filter-chip.active{background:var(--text);color:#fff;border-color:var(--text);}
.filter-chip.more{background:var(--bg);border-color:var(--bg);display:flex;align-items:center;gap:4px;}
.filter-chip.more i{font-size:12px;}
.filter-chip.more .badge-count{background:var(--primary);color:#fff;font-size:9px;padding:1px 6px;border-radius:10px;display:none;}

/* Vehicle List */
.vehicle-list{flex:1;overflow-y:auto;padding:0 16px 16px;-webkit-overflow-scrolling:touch;}
.vehicle-list::-webkit-scrollbar{display:none;}

/* Skeleton */
.skeleton-card{background:var(--card);border-radius:var(--radius);padding:14px;margin-bottom:12px;display:flex;gap:14px;border:1px solid var(--border);}
.skeleton-img{width:80px;height:80px;border-radius:12px;background:linear-gradient(90deg,#f1f5f9 25%,#e2e8f0 50%,#f1f5f9 75%);background-size:200% 100%;animation:shimmer 1.5s infinite;flex-shrink:0;}
.skeleton-body{flex:1;}
.skeleton-line{height:12px;border-radius:6px;background:linear-gradient(90deg,#f1f5f9 25%,#e2e8f0 50%,#f1f5f9 75%);background-size:200% 100%;animation:shimmer 1.5s infinite;margin-bottom:8px;}
.skeleton-line.w60{width:60%;}
.skeleton-line.w40{width:40%;}
.skeleton-line.w80{width:80%;}
@keyframes shimmer{0%{background-position:200% 0}100%{background-position:-200% 0}}

/* Vehicle Card */
.vehicle-card{background:var(--card);border-radius:var(--radius);padding:14px;margin-bottom:10px;display:flex;gap:14px;border:1px solid var(--border);transition:all .15s;cursor:pointer;position:relative;}
.vehicle-card:active{transform:scale(0.98);border-color:var(--primary);}
.vehicle-card .v-img{width:100px;height:80px;border-radius:12px;object-fit:cover;background:var(--bg);flex-shrink:0;}
.vehicle-card .v-body{flex:1;min-width:0;}
.vehicle-card .v-name{font-size:15px;font-weight:700;color:var(--text);display:flex;align-items:center;gap:6px;}
.vehicle-card .v-name .verified-badge{color:#10b981;font-size:12px;}
.vehicle-card .v-type{font-size:11px;color:var(--text3);margin:1px 0 4px;display:flex;gap:8px;align-items:center;}
.vehicle-card .v-meta{display:flex;flex-wrap:wrap;gap:4px 10px;font-size:11px;color:var(--text2);margin-bottom:4px;}
.vehicle-card .v-meta span{display:flex;align-items:center;gap:3px;}
.vehicle-card .v-meta i{font-size:10px;color:var(--text3);}
.vehicle-card .v-bottom{display:flex;align-items:center;justify-content:space-between;margin-top:4px;}
.vehicle-card .v-fare{font-size:18px;font-weight:800;color:var(--primary);}
.vehicle-card .v-fare small{font-size:11px;font-weight:500;color:var(--text3);}
.vehicle-card .v-avail{font-size:10px;color:#10b981;display:flex;align-items:center;gap:3px;}
.vehicle-card .v-avail .dot{width:6px;height:6px;border-radius:50%;background:#10b981;display:inline-block;animation:pulse 2s infinite;}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:0.4}}
.vehicle-card .v-rating{font-size:11px;font-weight:600;color:var(--text2);display:flex;align-items:center;gap:2px;}
.vehicle-card .v-rating i{color:#f59e0b;font-size:10px;}

.book-btn{background:var(--primary);color:#fff;border:none;border-radius:10px;padding:8px 16px;font-size:12px;font-weight:700;cursor:pointer;transition:all .15s;flex-shrink:0;}
.book-btn:active{transform:scale(0.95);background:var(--primary-dark);}

/* Empty State */
.empty-state{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:60px 20px;text-align:center;}
.empty-state .empty-icon{width:80px;height:80px;border-radius:50%;background:var(--bg);display:flex;align-items:center;justify-content:center;font-size:32px;color:var(--text3);margin-bottom:16px;}
.empty-state h3{font-size:18px;font-weight:700;color:var(--text);margin-bottom:4px;}
.empty-state p{font-size:13px;color:var(--text3);max-width:260px;}

/* ── Filter Modal ── */
.filter-overlay{position:fixed;inset:0;background:rgba(0,0,0,0.4);z-index:1000;display:none;animation:fadeIn .2s;}
.filter-overlay.show{display:block;}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
.filter-panel{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:100%;max-width:480px;background:var(--card);border-radius:24px 24px 0 0;z-index:1001;padding:0 0 24px;max-height:85vh;overflow-y:auto;display:none;animation:slideUp .3s ease-out;}
.filter-panel.show{display:block;}
@keyframes slideUp{from{transform:translateX(-50%) translateY(100%);opacity:0}to{transform:translateX(-50%) translateY(0);opacity:1}}
.filter-panel .fp-header{display:flex;align-items:center;justify-content:space-between;padding:16px 20px;border-bottom:1px solid var(--border);position:sticky;top:0;background:var(--card);z-index:2;}
.filter-panel .fp-header h3{font-size:17px;font-weight:700;}
.filter-panel .fp-header .close-btn{width:32px;height:32px;border:none;border-radius:50%;background:var(--bg);cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--text2);font-size:14px;}
.filter-panel .fp-body{padding:16px 20px;}
.filter-panel .fp-section{margin-bottom:20px;}
.filter-panel .fp-section:last-child{margin-bottom:0;}
.filter-panel .fp-section h4{font-size:12px;font-weight:600;color:var(--text3);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:10px;}
.filter-panel .fp-tags{display:flex;flex-wrap:wrap;gap:6px;}
.filter-panel .fp-tag{padding:8px 16px;border-radius:20px;font-size:13px;font-weight:500;border:1.5px solid var(--border);background:var(--card);color:var(--text2);cursor:pointer;transition:all .15s;}
.filter-panel .fp-tag.active{background:var(--text);color:#fff;border-color:var(--text);}
.filter-panel .fp-tag:active{transform:scale(0.95);}
.filter-panel .fp-row{display:flex;align-items:center;justify-content:space-between;padding:10px 0;}
.filter-panel .fp-row label{font-size:14px;font-weight:500;color:var(--text);}
.filter-panel .fp-row .toggle{width:44px;height:24px;border-radius:12px;background:var(--border);cursor:pointer;position:relative;transition:all .2s;flex-shrink:0;}
.filter-panel .fp-row .toggle.active{background:var(--primary);}
.filter-panel .fp-row .toggle::after{content:'';position:absolute;top:2px;left:2px;width:20px;height:20px;border-radius:50%;background:#fff;transition:all .2s;box-shadow:0 1px 4px rgba(0,0,0,0.15);}
.filter-panel .fp-row .toggle.active::after{left:22px;}
.filter-panel .fp-footer{display:flex;gap:10px;padding:16px 20px 0;border-top:1px solid var(--border);}
.filter-panel .fp-footer button{flex:1;padding:14px;border-radius:12px;font-size:14px;font-weight:700;cursor:pointer;transition:all .15s;}
.filter-panel .fp-reset{background:var(--bg);border:1.5px solid var(--border);color:var(--text2);}
.filter-panel .fp-reset:active{opacity:0.7;}
.filter-panel .fp-apply{background:linear-gradient(135deg,var(--primary),#7c3aed);border:none;color:#fff;}
.filter-panel .fp-apply:active{transform:scale(0.97);}
.filter-panel .fp-apply .count-badge{background:rgba(255,255,255,0.25);border-radius:10px;padding:1px 8px;font-size:11px;margin-left:6px;}

/* Price Range Slider */
.price-range{display:flex;align-items:center;gap:10px;}
.price-range input[type=range]{flex:1;height:4px;-webkit-appearance:none;appearance:none;background:var(--border);border-radius:4px;outline:none;}
.price-range input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:20px;height:20px;border-radius:50%;background:var(--primary);cursor:pointer;box-shadow:0 1px 6px rgba(37,99,235,0.3);}
.price-range .price-label{font-size:13px;font-weight:600;color:var(--text);min-width:60px;text-align:center;background:var(--bg);padding:4px 8px;border-radius:8px;}

/* ── Toast ── */
.toast{position:fixed;bottom:80px;left:50%;transform:translateX(-50%);background:var(--text);color:#fff;padding:12px 20px;border-radius:12px;font-size:13px;font-weight:500;z-index:2000;display:none;animation:toastIn .3s;max-width:90%;text-align:center;}
.toast.show{display:block;}
@keyframes toastIn{from{transform:translateX(-50%) translateY(20px);opacity:0}to{transform:translateX(-50%) translateY(0);opacity:1}}

/* ── Bottom Navigation ── */
.bottom-nav{display:flex;align-items:center;justify-content:space-around;background:var(--card);border-top:1px solid var(--border);padding:6px 0 env(safe-area-inset-bottom,6px);flex-shrink:0;position:relative;z-index:10;}
.nav-item{display:flex;flex-direction:column;align-items:center;gap:2px;border:none;background:none;cursor:pointer;padding:4px 12px;transition:all .15s;text-decoration:none;}
.nav-item i{font-size:18px;color:var(--text3);transition:color .15s;}
.nav-item span{font-size:10px;font-weight:500;color:var(--text3);transition:color .15s;}
.nav-item.active i,.nav-item.active span{color:var(--primary);}
.nav-item:active{transform:scale(0.92);}

/* ── Responsive ── */
@media(min-width:768px){
  .app{max-width:480px;border-left:1px solid var(--border);border-right:1px solid var(--border);}
}
</style>
</head>
<body>

<div class="app">

  <!-- Header -->
  <header class="header">
    <div class="header-logo">
      <div class="icon"><i class="fas fa-car"></i></div>
      <span>RideLocal</span>
    </div>
    <div class="header-actions">
      <button class="notif-btn" onclick="window.location.href='/notifications'" aria-label="Notifications">
        <i class="fas fa-bell"></i>
        <span class="notif-badge" id="headerNotifBadge">0</span>
      </button>
      <% if(currUser) { %>
        <button class="avatar-btn" onclick="window.location.href='/users/profile'">
          <% if(currUser.profilePhoto && currUser.profilePhoto.url) { %>
            <img src="<%= currUser.profilePhoto.url %>" alt="">
          <% } else { %>
            <%= currUser.username.charAt(0).toUpperCase() %>
          <% } %>
        </button>
      <% } else { %>
        <button class="avatar-btn" onclick="window.location.href='/users/login'" style="background:var(--bg);color:var(--text2);font-size:14px;">
          <i class="fas fa-user"></i>
        </button>
      <% } %>
    </div>
  </header>

  <!-- Scrollable Content -->
  <div class="scroll-area" id="scrollArea">

    <!-- Welcome -->
    <div class="welcome" id="welcomeSection">
      <h1 id="greeting"></h1>
      <p id="greetingSub">Where would you like to go today?</p>
    </div>

    <!-- Quick Info Strip -->
    <div class="quick-strip">
      <button class="quick-chip" onclick="setTripType(this,'local')"><i class="fas fa-city"></i> Local</button>
      <button class="quick-chip" onclick="setTripType(this,'outstation')"><i class="fas fa-road"></i> Outstation</button>
      <button class="quick-chip" onclick="setTripType(this,'airport')"><i class="fas fa-plane"></i> Airport</button>
      <button class="quick-chip" onclick="setTripType(this,'wedding')"><i class="fas fa-ring"></i> Wedding</button>
      <button class="quick-chip" onclick="setTripType(this,'temple')"><i class="fas fa-place-of-worship"></i> Temple</button>
    </div>

    <!-- Search Card -->
    <div class="search-section" id="searchSection">
      <div class="search-card">
        <div class="title"><i class="fas fa-magnifying-glass"></i> Book a Nearby Vehicle</div>

        <!-- Pickup -->
        <div class="form-group" style="position:relative;">
          <label>Pickup Location</label>
          <div class="input-wrap">
            <span class="icon green"><i class="fas fa-circle-dot"></i></span>
            <input type="text" id="pickupInput" placeholder="Enter pickup location" autocomplete="off">
          </div>
          <button class="current-loc-btn" id="currLocBtn" onclick="getCurrentLocation()">
            <i class="fas fa-location-crosshairs"></i> Use Current Location
          </button>
          <div class="loc-loading" id="locLoading"><i class="fas fa-spinner fa-spin"></i> Detecting location...</div>
          <div class="autocomplete-dropdown" id="pickupDropdown"></div>
        </div>

        <!-- Destination -->
        <div class="form-group" style="position:relative;">
