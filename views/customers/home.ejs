<script>
async function loadFeaturedVehicles() {
  const el = document.getElementById('featuredVehicles');
  try {
    const res = await fetch('/customers/api/search', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({})
    });
    const data = await res.json();
    if (!data.success || !data.vehicles || !data.vehicles.length) {
      el.innerHTML = '<div style="text-align:center;padding:40px;color:var(--text-muted);grid-column:1/-1"><i class="fas fa-car" style="font-size:48px;margin-bottom:16px;display:block"></i><p>No vehicles available yet. Be the first to list your vehicle!</p></div>';
      return;
    }
    const vehicles = data.vehicles.slice(0, 6);
    el.innerHTML = vehicles.map(v => {
      const img = v.image || 'https://images.pexels.com/photos/11129937/pexels-photo-11129937.jpeg';
      return `
        <div class="vehicle-card" onclick="location.href='/cars/${v._id}'">
          <div class="vehicle-image" style="background:var(--surface);overflow:hidden">
            <img src="${img}" alt="${v.title}" style="width:100%;height:100%;object-fit:cover" onerror="this.style.display='none';this.parentNode.innerHTML='<i class=\\'fas fa-car\\'></i>'">
          </div>
          <div class="vehicle-body">
            <div class="vehicle-rating"><i class="fas fa-star"></i> ${v.rating || 'New'} ${v.totalReviews ? '('+v.totalReviews+')' : ''}</div>
            <h3>${v.vehicleName}</h3>
            <div class="vehicle-location"><i class="fas fa-map-marker-alt"></i> ${v.distanceFromPickup ? v.distanceFromPickup + ' km away' : 'Available now'}</div>
            <div class="vehicle-specs">
              <span><i class="fas fa-users"></i> ${v.seats} seats</span>
              <span><i class="fas fa-cog"></i> ${v.transmission}</span>
              ${v.acAvailable ? '<span><i class="fas fa-snowflake"></i> AC</span>' : ''}
            </div>
            <div class="vehicle-price">₹${v.estimatedFare} <span>est.</span></div>
          </div>
        </div>
      `;
    }).join('');
  } catch(e) {
    el.innerHTML = '<div style="text-align:center;padding:40px;color:var(--text-muted);grid-column:1/-1"><p>Unable to load vehicles. Please try again.</p></div>';
  }
}
document.addEventListener('DOMContentLoaded', loadFeaturedVehicles);
</script>

