<!-- Toast -->
<div class="toast" id="toast"></div>

<script src="https://cdn.socket.io/4.7.5/socket.io.min.js"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
// ── Configuration ──
const SEARCH_API = '/customers/api/search';
const AUTOCOMPLETE_API = '/cars/autocomplete';
const GEOCODE_API = '/cars/geocode';
let currentUser = '<%= currUser ? currUser._id : "" %>';
let currentUserName = '<%= currUser ? currUser.username : "" %>';

// ── State ──
let state = {
  pax: 1,
  pickup: { text: '', lat: null, lng: null },
  destination: { text: '', lat: null, lng: null },
  date: '',
  time: '',
  vehicleType: 'all',
  sort: 'all',
  searchResults: [],
  tripData: null,
  filters: { seats: 0, vtype: 'all', maxPrice: 50000, acOnly: false, rating4: false, verified: false },
  map: null,
  markers: [],
  activeFilterCount: 0
};

// ── Initialize ──
(function init() {
  // Set default date/time
  const now = new Date();
  const dateEl = document.getElementById('travelDate');
  dateEl.value = now.toISOString().split('T')[0];
  dateEl.min = now.toISOString().split('T')[0];
  const timeEl = document.getElementById('pickupTime');
  timeEl.value = String(now.getHours()).padStart(2,'0') + ':' + String(now.getMinutes()+30).padStart(2,'0');

  state.date = dateEl.value;
  state.time = timeEl.value;

  // Greeting
  const hour = now.getHours();
  let greeting = 'Good Evening';
  if (hour < 12) greeting = 'Good Morning';
  else if (hour < 17) greeting = 'Good Afternoon';
  const name = currentUserName || 'there';
  document.getElementById('greeting').innerHTML = greeting + ', <span>' + name.split(' ')[0] + '</span>';

  // Autocomplete
  setupAutocomplete('pickupInput', 'pickupDropdown', (item) => {
    state.pickup = { text: item.primary, lat: parseFloat(item.lat), lng: parseFloat(item.lon) };
    document.getElementById('pickupInput').value = item.primary;
  });
  setupAutocomplete('destInput', 'destDropdown', (item) => {
    state.destination = { text: item.primary, lat: parseFloat(item.lat), lng: parseFloat(item.lon) };
    document.getElementById('destInput').value = item.primary;
  });

  // Fetch notification count
  fetchNotifCount();
})();

// ── Autocomplete ──
function setupAutocomplete(inputId, dropdownId, onSelect) {
  const input = document.getElementById(inputId);
  const dropdown = document.getElementById(dropdownId);
  let timeout, selectedIndex = -1, results = [];

  input.addEventListener('input', function() {
    clearTimeout(timeout);
    const val = this.value.trim();
    if (val.length < 2) { dropdown.classList.remove('show'); return; }
    timeout = setTimeout(async () => {
      try {
        const r = await fetch(AUTOCOMPLETE_API + '?q=' + encodeURIComponent(val));
        results = await r.json();
        renderDropdown(results);
      } catch(e) { dropdown.classList.remove('show'); }
    }, 300);
  });

  input.addEventListener('keydown', function(e) {
    const items = dropdown.querySelectorAll('.autocomplete-item');
    if (e.key === 'ArrowDown') { e.preventDefault(); selectedIndex = Math.min(selectedIndex + 1, items.length - 1); highlightItem(items); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); selectedIndex = Math.max(selectedIndex - 1, -1); highlightItem(items); }
    else if (e.key === 'Enter' && selectedIndex >= 0 && results[selectedIndex]) {
      e.preventDefault(); selectItem(results[selectedIndex]);
    } else if (e.key === 'Escape') { dropdown.classList.remove('show'); }
  });

  document.addEventListener('click', function(e) {
    if (!input.contains(e.target) && !dropdown.contains(e.target)) dropdown.classList.remove('show');
  });

  function renderDropdown(items) {
    dropdown.innerHTML = '';
    if (!items || items.length === 0) { dropdown.classList.remove('show'); return; }
    selectedIndex = -1;
    items.forEach((item, i) => {
      const div = document.createElement('div');
      div.className = 'autocomplete-item';
      div.innerHTML = '<div class="loc-icon"><i class="fas fa-location-dot"></i></div><div class="loc-text"><div class="loc-primary">' + escapeHtml(item.primary || item.display_name) + '</div><div class="loc-secondary">' + escapeHtml(item.secondary || '') + '</div></div>';
      div.addEventListener('click', () => selectItem(item));
      div.addEventListener('mouseenter', () => { selectedIndex = i; highlightItem(items, true); });
      dropdown.appendChild(div);
    });
    dropdown.classList.add('show');
  }

  function highlightItem(items, skipScroll) {
    items.forEach((el, i) => el.classList.toggle('highlighted', i === selectedIndex));
    if (!skipScroll && items[selectedIndex]) items[selectedIndex].scrollIntoView({ block: 'nearest' });
  }

  function selectItem(item) {
    onSelect(item);
    dropdown.classList.remove('show');
  }
}

function escapeHtml(text) {
  if (!text) return '';
  const d = document.createElement('div');
  d.textContent = text;
  return d.innerHTML;
}

// ── Current Location ──
function getCurrentLocation() {
  if (!navigator.geolocation) { showToast('Geolocation not supported'); return; }
  const btn = document.getElementById('currLocBtn');
  const loading = document.getElementById('locLoading');
  btn.style.display = 'none';
  loading.classList.add('show');
  navigator.geolocation.getCurrentPosition(async (pos) => {
    const lat = pos.coords.latitude, lng = pos.coords.longitude;
    state.pickup.lat = lat;
    state.pickup.lng = lng;
    try {
      const r = await fetch(GEOCODE_API + '?lat=' + lat + '&lon=' + lng);
      const data = await r.json();
      const name = data.display_name || lat + ', ' + lng;
      state.pickup.text = name.split(',')[0].trim();
      document.getElementById('pickupInput').value = state.pickup.text;
    } catch(e) {
      document.getElementById('pickupInput').value = 'Current Location';
      state.pickup.text = 'Current Location';
    }
    loading.classList.remove('show');
    btn.style.display = 'flex';
  }, () => {
    loading.classList.remove('show');
    btn.style.display = 'flex';
    showToast('Could not get location. Please enter manually.');
  }, { enableHighAccuracy: true, timeout: 10000 });
}

// ── Passengers ──
function changePax(delta) {
  state.pax = Math.max(1, Math.min(20, state.pax + delta));
  document.getElementById('paxCount').textContent = state.pax;
}

// ── Quick Trip Types ──
function setTripType(btn, type) {
  document.querySelectorAll('.quick-chip').forEach(c => c.classList.remove('active'));
  btn.classList.add('active');
  // Pre-fill based on type
  const destinations = {
    local: 'City Center',
    outstation: 'Nearby City',
    airport: 'Airport',
    wedding: 'Wedding Venue',
    temple: 'Temple'
  };
  if (type !== 'local' && state.pickup.text) {
    document.getElementById('destInput').value = destinations[type] || '';
    state.destination.text = destinations[type] || '';
  }
  if (type === 'airport') {
    document.getElementById('vehicleType').value = 'Sedan';
    state.vehicleType = 'Sedan';
  }
}

// ── Search ──
async function performSearch() {
  const pickupText = document.getElementById('pickupInput').value.trim();
  const destText = document.getElementById('destInput').value.trim();
  if (!pickupText) { showToast('Please enter pickup location'); return; }
  if (!destText) { showToast('Please enter destination'); return; }

  showSkeletons();
  const resultsArea = document.getElementById('resultsArea');
  resultsArea.classList.add('show');

  // Scroll to results smoothly
  document.getElementById('scrollArea').scrollTo({ top: 0, behavior: 'smooth' });

  const body = {
    pickup: pickupText,
    destination: destText,
    pickupLat: state.pickup.lat,
    pickupLng: state.pickup.lng,
    destLat: state.destination.lat,
    destLng: state.destination.lng,
    passengers: state.pax,
    vehicleType: state.vehicleType,
    sort: state.sort === 'all' ? 'nearest' : state.sort,
    acOnly: state.filters.acOnly,
    verifiedOnly: state.filters.verified,
    minRating: state.filters.rating4 ? 4 : 0,
    maxPrice: state.filters.maxPrice < 50000 ? state.filters.maxPrice : 0,
    seatCapacity: state.filters.seats || 0
  };

  try {
    const res = await fetch(SEARCH_API, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body)
    });
    const data = await res.json();
    if (!data.success) { showToast(data.error || 'Search failed'); hideSkeletons(); return; }

    state.searchResults = data.vehicles || [];
    state.tripData = data.trip;
    renderResults(data);
  } catch(e) {
    showToast('Search failed. Please try again.');
    hideSkeletons();
  }
}

function showSkeletons() {
  const list = document.getElementById('vehicleList');
  let html = '';
  for (let i = 0; i < 4; i++) {
    html += '<div class="skeleton-card"><div class="skeleton-img"></div><div class="skeleton-body"><div class="skeleton-line w80"></div><div class="skeleton-line w60"></div><div class="skeleton-line w40"></div></div></div>';
  }
  list.innerHTML = html;
  document.getElementById('resultsCount').textContent = 'Searching...';
  document.getElementById('resultsTitle').textContent = 'Finding vehicles...';
}

function hideSkeletons() {
  // handled by renderResults
}

function renderResults(data) {
  const list = document.getElementById('vehicleList');
  const vehicles = data.vehicles || [];
  const trip = data.trip;

  document.getElementById('resultsTitle').textContent = 'Available Vehicles';
  document.getElementById('resultsCount').textContent = vehicles.length + ' found';

  // Map overlay
  if (trip) {
    document.getElementById('mapRoute').textContent = trip.pickup.substring(0, 25) + ' → ' + trip.destination.substring(0, 25);
    document.getElementById('mapDist').querySelector('span').textContent = trip.distanceKm + ' km · ~' + Math.round(trip.estimatedDuration/60) + ' min';
  }

  if (vehicles.length === 0) {
    list.innerHTML = '<div class="empty-state"><div class="empty-icon"><i class="fas fa-car"></i></div><h3>No vehicles found</h3><p>Try changing your pickup location or filters</p></div>';
    initMap(trip, []);
    return;
  }

  // Build vehicle cards
  let html = '';
  vehicles.forEach(v => {
    const badges = [];
    if (v.verified) badges.push('<span class="verified-badge"><i class="fas fa-check-circle"></i></span>');
    if (v.acAvailable) badges.push('<span class="text3">❄️ AC</span>');

    html += '<div class="vehicle-card" onclick="bookVehicle(\'' + v._id + '\')">' +
      '<img class="v-img" src="' + (v.image || 'https://images.pexels.com/photos/11129937/pexels-photo-11129937.jpeg') + '" loading="lazy" onerror="this.src=\'https://images.pexels.com/photos/11129937/pexels-photo-11129937.jpeg\'" alt="">' +
      '<div class="v-body">' +
        '<div class="v-name">' + escapeHtml(v.vehicleName || v.title) + ' ' + (v.verified ? '<i class="fas fa-check-circle" style="color:#10b981;font-size:12px;"></i>' : '') + '</div>' +
        '<div class="v-type">' + escapeHtml(v.vehicleType) + ' · ' + v.seats + ' seats' + (v.acAvailable ? ' · ❄️ AC' : '') + '</div>' +
        '<div class="v-meta">' +
          '<span><i class="fas fa-location-dot"></i> ' + v.distanceFromPickup + ' km</span>' +
          '<span><i class="fas fa-clock"></i> ~' + v.etaMin + ' min</span>' +
          '<span><i class="fas fa-star" style="color:#f59e0b;"></i> ' + v.rating.toFixed(1) + '</span>' +
        '</div>' +
        '<div class="v-bottom">' +
          '<div class="v-fare">₹' + v.estimatedFare.toLocaleString('en-IN') + ' <small>est.</small></div>' +
          '<div class="v-avail"><span class="dot"></span> Available</div>' +
        '</div>' +
      '</div>' +
    '</div>';
  });
  list.innerHTML = html;

  // Init map
  initMap(trip, vehicles);

  // Smooth scroll to results
  setTimeout(() => {
    document.getElementById('resultsArea').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }, 100);
}

// ── Map ──
function initMap(trip, vehicles) {
  const container = document.getElementById('searchMap');
  if (!trip) return;

  if (state.map) {
    state.map.remove();
    state.map = null;
    state.markers = [];
  }

  const pickupLat = trip.pickupLat, pickupLng = trip.pickupLng;
  const destLat = trip.destLat || pickupLat + 0.01, destLng = trip.destLng || pickupLng + 0.01;

  state.map = L.map(container, {
    center: [(pickupLat + destLat) / 2, (pickupLng + destLng) / 2],
    zoom: 13,
    zoomControl: false,
    attributionControl: false,
    dragging: true
  });

  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 19
  }).addTo(state.map);

  // Custom icons
  const pickupIcon = L.divIcon({
    html: '<div style="background:#10b981;width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:12px;border:3px solid #fff;box-shadow:0 2px 8px rgba(0,0,0,0.2);"><i class="fas fa-circle-dot"></i></div>',
    className: '',
    iconSize: [28, 28],
    iconAnchor: [14, 14]
  });

  const destIcon = L.divIcon({
    html: '<div style="background:#ef4444;width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:12px;border:3px solid #fff;box-shadow:0 2px 8px rgba(0,0,0,0.2);"><i class="fas fa-flag"></i></div>',
    className: '',
    iconSize: [28, 28],
    iconAnchor: [14, 14]
  });

  // Pickup marker
  L.marker([pickupLat, pickupLng], { icon: pickupIcon }).addTo(state.map)
    .bindPopup('Pickup: ' + (trip.pickup || '').substring(0, 30));

  // Destination marker
  L.marker([destLat, destLng], { icon: destIcon }).addTo(state.map)
    .bindPopup('Destination: ' + (trip.destination || '').substring(0, 30));

  // Vehicle markers
  const vehicleIcon = L.divIcon({
    html: '<div style="background:#2563eb;width:22px;height:22px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:10px;border:2px solid #fff;box-shadow:0 1px 6px rgba(0,0,0,0.2);"><i class="fas fa-car"></i></div>',
    className: '',
    iconSize: [22, 22],
    iconAnchor: [11, 11]
  });

  vehicles.forEach(v => {
    if (v.lat && v.lng) {
      const marker = L.marker([v.lat, v.lng], { icon: vehicleIcon }).addTo(state.map);
      marker.bindPopup('<b>' + (v.vehicleName || 'Vehicle') + '</b><br>₹' + v.estimatedFare + ' · ' + v.distanceFromPickup + ' km');
      state.markers.push(marker);
    }
  });

  // Fit bounds
  if (vehicles.length > 0) {
    const bounds = [[pickupLat, pickupLng], [destLat, destLng]];
    vehicles.forEach(v => { if (v.lat && v.lng) bounds.push([v.lat, v.lng]); });
    state.map.fitBounds(bounds, { padding: [40, 40], maxZoom: 15 });
  }

  setTimeout(() => state.map.invalidateSize(), 300);
}

// ── Sorting & Filtering ──
function applySort(sort) {
  state.sort = sort;
  document.querySelectorAll('.filter-chip').forEach(c => c.classList.remove('active'));
  const chips = document.querySelectorAll('.filter-chip');
  chips.forEach(c => { if (c.dataset.sort === sort) c.classList.add('active'); });

  let results = [...state.searchResults];
  if (sort === 'nearest') results.sort((a,b) => a.distanceFromPickup - b.distanceFromPickup);
  else if (sort === 'rating') results.sort((a,b) => b.rating - a.rating);
  else if (sort === 'price_low') results.sort((a,b) => a.estimatedFare - b.estimatedFare);
  else if (sort === 'price_high') results.sort((a,b) => b.estimatedFare - a.estimatedFare);
  else if (['suv','sedan','traveller','luxury'].includes(sort)) {
    const typeMap = { suv: 'SUV', sedan: 'Sedan', traveller: 'Traveller', luxury: 'Luxury' };
    results = results.filter(v => v.vehicleType.toLowerCase() === typeMap[sort].toLowerCase());
  }

  renderList(results);
}

function applyVehicleFilter(type) {
  let results = [...state.searchResults].filter(v => v.vehicleType === type);
  renderList(results);
  // Highlight the chip
  document.querySelectorAll('.filter-chip').forEach(c => c.classList.remove('active'));
}

function renderList(vehicles) {
  const list = document.getElementById('vehicleList');
  document.getElementById('resultsCount').textContent = vehicles.length + ' found';
  if (vehicles.length === 0) {
    list.innerHTML = '<div class="empty-state"><div class="empty-icon"><i class="fas fa-car"></i></div><h3>No vehicles match</h3><p>Try changing your filters</p></div>';
    return;
  }
  let html = '';
  vehicles.forEach(v => {
    html += '<div class="vehicle-card" onclick="bookVehicle(\'' + v._id + '\')">' +
      '<img class="v-img" src="' + (v.image || 'https://images.pexels.com/photos/11129937/pexels-photo-11129937.jpeg') + '" loading="lazy" onerror="this.src=\'https://images.pexels.com/photos/11129937/pexels-photo-11129937.jpeg\'" alt="">' +
      '<div class="v-body">' +
        '<div class="v-name">' + escapeHtml(v.vehicleName || v.title) + ' ' + (v.verified ? '<i class="fas fa-check-circle" style="color:#10b981;font-size:12px;"></i>' : '') + '</div>' +
        '<div class="v-type">' + escapeHtml(v.vehicleType) + ' · ' + v.seats + ' seats' + (v.acAvailable ? ' · ❄️ AC' : '') + '</div>' +
        '<div class="v-meta">' +
          '<span><i class="fas fa-location-dot"></i> ' + v.distanceFromPickup + ' km</span>' +
          '<span><i class="fas fa-clock"></i> ~' + v.etaMin + ' min</span>' +
          '<span><i class="fas fa-star" style="color:#f59e0b;"></i> ' + v.rating.toFixed(1) + '</span>' +
        '</div>' +
        '<div class="v-bottom">' +
          '<div class="v-fare">₹' + v.estimatedFare.toLocaleString('en-IN') + ' <small>est.</small></div>' +
          '<div class="v-avail"><span class="dot"></span> Available</div>' +
        '</div>' +
      '</div>' +
    '</div>';
  });
  list.innerHTML = html;
}

// ── Filter Modal ──
function openFilterModal() {
  document.getElementById('filterOverlay').classList.add('show');
  document.getElementById('filterPanel').classList.add('show');
  document.body.style.overflow = 'hidden';
}

function closeFilterModal() {
  document.getElementById('filterOverlay').classList.remove('show');
  document.getElementById('filterPanel').classList.remove('show');
  document.body.style.overflow = '';
}

function selectFilterTag(el, group) {
  const parent = el.parentElement;
  parent.querySelectorAll('.fp-tag').forEach(t => t.classList.remove('active'));
  el.classList.add('active');
}

function toggleFilter(el, type) {
  el.classList.toggle('active');
}

function updatePriceLabel(val) {
  document.getElementById('priceLabel').textContent = '₹' + Number(val).toLocaleString('en-IN');
}

function resetFilters() {
  document.querySelectorAll('.fp-tag').forEach(t => {
    if (t.dataset.value === '0' || t.dataset.value === 'all') t.classList.add('active');
    else t.classList.remove('active');
  });
  document.querySelectorAll('.toggle').forEach(t => t.classList.remove('active'));
  document.getElementById('priceRange').value = 50000;
  document.getElementById('priceLabel').textContent = '₹50,000';
  state.filters = { seats: 0, vtype: 'all', maxPrice: 50000, acOnly: false, rating4: false, verified: false };
  updateFilterBadge();
}

function applyFilters() {
  const seatsTag = document.querySelector('#filterSeats .fp-tag.active');
  const vtypeTag = document.querySelector('#filterVType .fp-tag.active');
  state.filters = {
    seats: parseInt(seatsTag ? seatsTag.dataset.value : 0),
    vtype: vtypeTag ? vtypeTag.dataset.value : 'all',
    maxPrice: parseInt(document.getElementById('priceRange').value),
    acOnly: document.getElementById('filterAC').classList.contains('active'),
    rating4: document.getElementById('filterRating').classList.contains('active'),
    verified: document.getElementById('filterVerified').classList.contains('active')
  };

  let count = 0;
  if (state.filters.seats > 0) count++;
  if (state.filters.vtype !== 'all') count++;
  if (state.filters.maxPrice < 50000) count++;
  if (state.filters.acOnly) count++;
  if (state.filters.rating4) count++;
  if (state.filters.verified) count++;
  state.activeFilterCount = count;
  updateFilterBadge();

  // Re-search with filters
  closeFilterModal();
  performSearch();
}

function updateFilterBadge() {
  const badge = document.getElementById('filterBadgeCount');
  if (state.activeFilterCount > 0) {
    badge.textContent = state.activeFilterCount;
    badge.style.display = 'inline';
  } else {
    badge.style.display = 'none';
  }
}

// ── Booking ──
function bookVehicle(vehicleId) {
  const trip = state.tripData;
  const params = new URLSearchParams({
    pickup: trip ? trip.pickup : '',
    destination: trip ? trip.destination : '',
    pickupLat: trip ? trip.pickupLat : '',
    pickupLng: trip ? trip.pickupLng : '',
    destLat: trip ? trip.destLat : '',
    destLng: trip ? trip.destLng : '',
    distance: trip ? trip.distanceKm : '',
    date: state.date,
    time: state.time,
    passengers: state.pax
  });

  // Find vehicle fare
  const vehicle = state.searchResults.find(v => v._id === vehicleId);
  if (vehicle) params.set('fare', vehicle.estimatedFare);

  window.location.href = '/cars/book/' + vehicleId + '?' + params.toString();
}

// ── Notification Count ──
async function fetchNotifCount() {
  if (!currentUser) return;
  try {
    const r = await fetch('/owners/api/unread-count');
    const d = await r.json();
    if (d.success && d.unreadCount > 0) {
      const badge = document.getElementById('headerNotifBadge');
      badge.textContent = d.unreadCount > 99 ? '99+' : d.unreadCount;
      badge.style.display = 'flex';
    }
  } catch(e) {}
}

// ── Toast ──
function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(t._hide);
  t._hide = setTimeout(() => t.classList.remove('show'), 3000);
}

// ── Socket.IO for real-time ──
(function() {
  if (!currentUser) return;
  try {
    const socket = io();
    socket.on('connect', function() {
      socket.emit('join', currentUser);
    });
    socket.on('new_notification', function() {
      fetchNotifCount();
    });
  } catch(e) {}
})();

// ── Date/Time change handlers ──
document.getElementById('travelDate').addEventListener('change', function() { state.date = this.value; });
document.getElementById('pickupTime').addEventListener('change', function() { state.time = this.value; });
document.getElementById('vehicleType').addEventListener('change', function() { state.vehicleType = this.value; });
</script>
