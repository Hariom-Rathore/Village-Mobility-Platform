        <span class="fp-tag" data-value="5" onclick="selectFilterTag(this,'seats')">5 Seats</span>
        <span class="fp-tag" data-value="7" onclick="selectFilterTag(this,'seats')">7 Seats</span>
        <span class="fp-tag" data-value="10" onclick="selectFilterTag(this,'seats')">10+ Seats</span>
      </div>
    </div>
    <div class="fp-section">
      <h4>Vehicle Type</h4>
      <div class="fp-tags" id="filterVType">
        <span class="fp-tag active" data-value="all" onclick="selectFilterTag(this,'vtype')">All</span>
        <span class="fp-tag" data-value="SUV" onclick="selectFilterTag(this,'vtype')">SUV</span>
        <span class="fp-tag" data-value="Sedan" onclick="selectFilterTag(this,'vtype')">Sedan</span>
        <span class="fp-tag" data-value="Hatchback" onclick="selectFilterTag(this,'vtype')">Hatchback</span>
        <span class="fp-tag" data-value="Traveller" onclick="selectFilterTag(this,'vtype')">Traveller</span>
        <span class="fp-tag" data-value="Luxury" onclick="selectFilterTag(this,'vtype')">Luxury</span>
