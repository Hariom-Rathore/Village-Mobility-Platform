<script>
// ───────────────────────── AUTOCOMPLETE ─────────────────────────
function setupAutocomplete(inputId) {
  const input = document.getElementById(inputId);
  let container = document.createElement('div');
  container.className = 'ac-wrap';
  input.parentNode.style.position = 'relative';
  input.parentNode.appendChild(container);

  let timer, curFocus = -1;

  input.addEventListener('input', () => {
    clearTimeout(timer);
    const v = input.value.trim();
    if (v.length < 2) { container.innerHTML = ''; container.classList.remove('open'); return; }
    curFocus = -1;
    timer = setTimeout(async () => {
      try {
        const r = await fetch('/cars/autocomplete?q=' + encodeURIComponent(v));
        const d = await r.json();
        if (!d.length) { container.innerHTML = ''; container.classList.remove('open'); return; }
        container.innerHTML = d.map((item, i) =>
          '<div class="ac-item" data-index="' + i + '" data-primary="' + esc(item.primary) + '" data-secondary="' + esc(item.secondary) + '" data-lat="' + item.lat + '" data-lon="' + item.lon + '">' +
            '<i class="fas fa-map-marker-alt"></i>' +
            '<div><div class="ac-primary">' + esc(item.primary) + '</div><div class="ac-secondary">' + esc(item.secondary) + '</div></div>' +
          '</div>'
        ).join('');
        container.classList.add('open');

        container.querySelectorAll('.ac-item').forEach(el => {
          el.addEventListener('click', () => {
            input.value = el.dataset.primary;
            input.dataset.lat = el.dataset.lat;
            input.dataset.lon = el.dataset.lon;
            input.dataset.display = el.dataset.primary + ', ' + el.dataset.secondary;
            container.innerHTML = '';
            container.classList.remove('open');
          });
        });
      } catch(e) { container.classList.remove('open'); }
    }, 300);
  });

  input.addEventListener('keydown', (e) => {
    const items = container.querySelectorAll('.ac-item');
    if (!items.length) return;
    if (e.key === 'ArrowDown') { e.preventDefault(); curFocus = Math.min(curFocus + 1, items.length - 1); focusItem(items, curFocus); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); curFocus = Math.max(curFocus - 1, 0); focusItem(items, curFocus); }
    else if (e.key === 'Enter') { e.preventDefault(); items[curFocus >= 0 ? curFocus : 0]?.click(); }
    else if (e.key === 'Escape') { container.innerHTML = ''; container.classList.remove('open'); }
  });

  document.addEventListener('click', (e) => {
    if (!e.target.closest('.ac-wrap') && !e.target.closest('#' + inputId)) {
      container.innerHTML = '';
      container.classList.remove('open');
    }
  });
}

function focusItem(items, i) {
  items.forEach(el => el.classList.remove('ac-focus'));
  items[i].classList.add('ac-focus');
  items[i].scrollIntoView({ block: 'nearest' });
}

function esc(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

function handleSearch() {
  const pickup = document.getElementById('searchPickup').value;
  const dest = document.getElementById('searchDest').value;
  const date = document.getElementById('searchDate').value;
  const time = document.getElementById('searchTime').value;
  const passengers = document.getElementById('searchPassengers').value;
  const params = new URLSearchParams();
  if (pickup) params.set('pickup', pickup);
  if (dest) params.set('destination', dest);
  if (date) params.set('date', date);
  if (time) params.set('time', time);
  if (passengers) params.set('passengers', passengers);
  window.location.href = '/cars?' + params.toString();
}

document.addEventListener('DOMContentLoaded', () => {
  setupAutocomplete('searchPickup');
  setupAutocomplete('searchDest');
});
</script>

