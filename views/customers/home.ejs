      <h4>Max Price</h4>
      <div class="price-range">
        <span class="price-label" id="priceLabel">₹5000</span>
        <input type="range" id="priceRange" min="500" max="50000" step="500" value="50000" oninput="updatePriceLabel(this.value)">
      </div>
