<% layout('/listings/layouts/boilerplate') %>
<div class="error-page fade-in">
  <div class="card" style="text-align:center;padding:60px 40px;max-width:480px;margin:0 auto">
    <h1 style="font-size:72px;font-weight:800;color:var(--primary);margin-bottom:8px;line-height:1"><%= statusCode %></h1>
    <h2 style="font-size:20px;font-weight:700;margin-bottom:8px">Oops! Something went wrong</h2>
    <p class="text-secondary"><%= errorMsg %></p>
    <a href="/" class="btn btn-primary btn-lg" style="margin-top:20px;display:inline-flex"><i class="fas fa-home"></i> Go Home</a>
  </div>
</div>
<style>.error-page{min-height:60vh;display:flex;align-items:center;justify-content:center;padding:20px;}</style>
