<% layout('/listings/layouts/boilerplate') %>
<style>
.error-page { min-height: 60vh; display: flex; align-items: center; justify-content: center; padding: 20px; text-align: center; }
.error-card h1 { font-size: 72px; font-weight: 800; color: #2563eb; margin-bottom: 8px; }
.error-card h2 { font-size: 20px; font-weight: 600; margin-bottom: 8px; }
.error-card p { color: #64748b; margin-bottom: 24px; }
.error-card .btn { background: #2563eb; color: white; border: none; border-radius: 12px; padding: 12px 24px; font-weight: 600; text-decoration: none; }
</style>
<div class="error-page">
  <div class="error-card">
    <h1><%= statusCode %></h1>
    <h2>Oops! Something went wrong</h2>
    <p><%= errorMsg %></p>
    <a href="/" class="btn"><i class="fas fa-home me-2"></i>Go Home</a>
  </div>
</div>