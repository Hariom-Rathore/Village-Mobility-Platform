<% layout("/listings/layouts/boilerplate") %>
<div class="dash-page">
  <div class="dash-header">
    <h1>My Dashboard</h1>
    <p>Welcome back, <%= currUser ? currUser.username : 'User' %></p>
  </div>

  <div class="stats-grid">
    <div class="stat-card"><div class="stat-icon" style="background:#2563eb"><i class="fas fa-calendar-check"></i></div><div class="stat-value"><%= stats.totalBookings %></div><div class="stat-label">Total Bookings</div></div>
    <div class="stat-card"><div class="stat-icon" style="background:#10b981"><i class="fas fa-check-circle"></i></div><div class="stat-value"><%= stats.completedBookings %></div><div class="stat-label">Completed</div></div>
    <div class="stat-card"><div class="stat-icon" style="background:#f59e0b"><i class="fas fa-clock"></i></div><div class="stat-value"><%= bookings.filter(b => b.bookingStatus === 'PENDING_OWNER_APPROVAL').length %></div><div class="stat-label">Pending</div></div>
    <div class="stat-card"><div class="stat-icon" style="background:#8b5cf6"><i class="fas fa-wallet"></i></div><div class="stat-value">₹<%= (stats.totalSpent || 0).toLocaleString('en-IN') %></div><div class="stat-label">Total Spent</div></div>
  </div>

  <!-- Counter Offers -->
  <% const co = bookings.filter(b => b.bookingStatus === 'COUNTER_OFFERED'); %>
  <% if (co.length > 0) { %>
    <div class="section-card" style="border-left:4px solid #f59e0b">
      <div class="section-header"><h3>Action Required: Counter Offers (<%= co.length %>)</h3></div>
      <div class="dash-table-wrap">
        <table class="dash-table">
          <thead><tr><th>Vehicle</th><th>Trip</th><th>Your Fare</th><th>Owner's Offer</th><th>Message</th><th>Actions</th></tr></thead>
          <tbody><% co.forEach(b => { %>
            <tr>
              <td><a href="/cars/<%= b.vehicleId?._id %>"><%= b.vehicleId?.title || 'N/A' %></a></td>
              <td><small><%= b.pickup %> &rarr; <%= b.destination %></small></td>
              <td>₹<%= (b.estimatedFare || 0).toLocaleString('en-IN') %></td>
              <td class="text-primary fw-bold">₹<%= (b.counterOffer?.totalFare || 0).toLocaleString('en-IN') %></td>
              <td><small><%= b.counterOffer?.message || '—' %></small></td>
              <td><div class="flex gap-sm"><button class="btn btn-sm btn-success" onclick="respondToOffer('<%= b._id %>','accept')"><i class="fas fa-check"></i> Accept</button><button class="btn btn-sm btn-danger" onclick="respondToOffer('<%= b._id %>','reject')"><i class="fas fa-times"></i> Reject</button></div></td>
            </tr><% }); %></tbody>
        </table>
      </div>
    </div>
  <% } %>

  <!-- Pending -->
  <% const pending = bookings.filter(b => b.bookingStatus === 'PENDING_OWNER_APPROVAL'); %>
  <% if (pending.length > 0) { %>
    <div class="section-card" style="border-left:4px solid #2563eb">
      <div class="section-header"><h3>Pending Approvals (<%= pending.length %>)</h3></div>
      <div class="dash-table-wrap">
        <table class="dash-table">
          <thead><tr><th>Vehicle</th><th>Trip</th><th>Date</th><th>Fare</th><th>Status</th></tr></thead>
          <tbody><% pending.forEach(b => { %>
            <tr>
              <td><a href="/cars/<%= b.vehicleId?._id %>"><%= b.vehicleId?.title || 'N/A' %></a></td>
              <td><small><%= b.pickup %> &rarr; <%= b.destination %></small></td>
              <td><%= b.pickupDate ? new Date(b.pickupDate).toLocaleDateString() : 'N/A' %></td>
              <td>₹<%= (b.estimatedFare || 0).toLocaleString('en-IN') %></td>
              <td><span class="badge badge-warning">Reviewing</span></td>
            </tr><% }); %></tbody>
        </table>
      </div>
    </div>
  <% } %>

  <!-- Active -->
  <% const active = bookings.filter(b => b.bookingStatus === 'CONFIRMED' || b.bookingStatus === 'PENDING'); %>
  <% if (active.length > 0) { %>
    <div class="section-card" style="border-left:4px solid #10b981">
      <div class="section-header"><h3>Active Bookings (<%= active.length %>)</h3></div>
      <div class="dash-table-wrap">
        <table class="dash-table">
          <thead><tr><th>Vehicle</th><th>Owner</th><th>Date</th><th>Amount</th><th>Status</th><th>Actions</th></tr></thead>
          <tbody><% active.forEach(b => { %>
            <tr>
              <td><%= b.vehicleId?.title || 'N/A' %></td>
              <td><%= b.ownerId?.username || 'N/A' %></td>
              <td><%= b.pickupDate ? new Date(b.pickupDate).toLocaleDateString() : 'N/A' %></td>
              <td>₹<%= (b.totalPrice || 0).toLocaleString('en-IN') %></td>
              <td><span class="badge badge-success"><%= b.bookingStatus %></span></td>
              <td><button class="btn btn-sm btn-danger" onclick="cancelBooking('<%= b._id %>')"><i class="fas fa-ban"></i> Cancel</button></td>
            </tr><% }); %></tbody>
        </table>
      </div>
    </div>
  <% } %>

  <!-- All Bookings -->
  <div class="section-card">
    <div class="section-header"><h3>All Bookings</h3></div>
    <% if (bookings.length === 0) { %>
      <p class="text-secondary">No bookings yet. <a href="/cars">Browse vehicles</a>.</p>
    <% } else { %>
      <div class="dash-table-wrap">
        <table class="dash-table">
          <thead><tr><th>Vehicle</th><th>Owner</th><th>Date</th><th>Amount</th><th>Status</th></tr></thead>
          <tbody><% bookings.forEach(b => { %>
            <tr>
              <td><a href="/cars/<%= b.vehicleId?._id %>"><%= b.vehicleId?.title || 'N/A' %></a></td>
              <td><%= b.ownerId?.username || 'N/A' %></td>
              <td><%= b.pickupDate ? new Date(b.pickupDate).toLocaleDateString() : 'N/A' %></td>
              <td>₹<%= (b.totalPrice || b.estimatedFare || 0).toLocaleString('en-IN') %></td>
              <td><span class="badge badge-<%= b.bookingStatus === 'COMPLETED' ? 'success' : b.bookingStatus === 'CANCELLED' || b.bookingStatus === 'REJECTED' ? 'danger' : b.bookingStatus === 'CONFIRMED' ? 'info' : 'secondary' %>"><%= b.bookingStatus %></span></td>
            </tr><% }); %></tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<script>
async function respondToOffer(id, action) {
  if(!confirm(`Are you sure?`)) return;
  try {
    const r = await fetch(`/cars/bookings/${id}/counter/respond`, { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({action}) });
    const d = await r.json();
    if(d.success) { alert(`Offer ${action}ed`); location.reload(); }
    else alert(d.error);
  } catch(e) { alert("Error"); }
}
async function cancelBooking(id) {
  if(!confirm('Cancel this booking?')) return;
  try {
    const r = await fetch(`/cars/bookings/${id}/cancel`, { method:'POST', headers:{'Content-Type':'application/json'} });
    const d = await r.json();
    if(d.success) { alert('Cancelled'); location.reload(); }
    else alert(d.error);
  } catch(e) { alert("Error"); }
}
</script>

<style>
.dash-page { max-width: var(--max-width); margin: 0 auto; padding: 32px 24px; }
.dash-header h1 { font-size: 28px; font-weight: 800; }
.dash-header p { color: var(--text-secondary); font-size: 14px; }
.stats-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 16px; margin: 24px 0; }
.section-card { background: var(--card); border: 1px solid var(--border-light); border-radius: var(--radius-lg); padding: 20px; margin-bottom: 20px; }
.section-header h3 { font-size: 16px; font-weight: 700; }
.dash-table-wrap { overflow-x: auto; margin-top: 12px; }
.dash-table { width: 100%; border-collapse: collapse; font-size: 14px; }
.dash-table th { text-align: left; padding: 10px 12px; font-size: 12px; font-weight: 600; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.3px; border-bottom: 2px solid var(--border); background: var(--surface); }
.dash-table td { padding: 10px 12px; border-bottom: 1px solid var(--border-light); }
.dash-table tr:hover td { background: var(--surface); }
.fw-bold { font-weight: 700; }
</style>
