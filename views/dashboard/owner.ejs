<% layout("/listings/layouts/boilerplate") %>

<div class="container mt-4">
  <h2>Owner Dashboard</h2>
  
  <!-- Statistics Cards -->
  <div class="row mb-4">
    <div class="col-md-3">
      <div class="card bg-primary text-white">
        <div class="card-body">
          <h5 class="card-title">Total Bookings</h5>
          <h3 class="card-text"><%= stats.totalBookings %></h3>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card bg-success text-white">
        <div class="card-body">
          <h5 class="card-title">Completed</h5>
          <h3 class="card-text"><%= stats.completedBookings %></h3>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card bg-warning text-white">
        <div class="card-body">
          <h5 class="card-title">Pending</h5>
          <h3 class="card-text"><%= stats.pendingBookings %></h3>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card bg-info text-white">
        <div class="card-body">
          <h5 class="card-title">Total Revenue</h5>
          <h3 class="card-text">₹<%= stats.totalRevenue.toLocaleString('en-IN') %></h3>
        </div>
      </div>
    </div>
  </div>

  <!-- My Vehicles -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          <h5>My Vehicles (<%= vehicles.length %>)</h5>
        </div>
        <div class="card-body">
          <% if (vehicles.length === 0) { %>
            <p class="text-muted">You haven't added any vehicles yet.</p>
            <a href="/cars/new" class="btn btn-primary">Add Your First Vehicle</a>
          <% } else { %>
            <div class="row">
              <% vehicles.forEach(vehicle => { %>
                <div class="col-md-4 mb-3">
                  <div class="card">
                    <% const listingImageUrl = (vehicle.image && vehicle.image.url) ? vehicle.image.url : (typeof vehicle.image === "string" ? vehicle.image : "https://images.pexels.com/photos/11129937/pexels-photo-11129937.jpeg"); %>
                    <img src="<%= listingImageUrl %>" class="card-img-top" alt="<%= vehicle.title %>" style="height: 150px; object-fit: cover;" loading="lazy">
                    <div class="card-body">
                      <h6 class="card-title"><%= vehicle.title %></h6>
                      <p class="card-text small text-muted">
                        ₹<%= vehicle.price %>/day | <%= vehicle.totalBookings || 0 %> bookings
                      </p>
                      <div class="d-flex justify-content-between align-items-center">
                        <span class="badge bg-<%= vehicle.availabilityStatus === 'AVAILABLE' ? 'success' : 'danger' %>">
                          <%= vehicle.availabilityStatus %>
                        </span>
                        <a href="/cars/<%= vehicle._id %>" class="btn btn-sm btn-outline-primary">View</a>
                      </div>
                    </div>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- Current Bookings -->
  <% if (currentBookings.length > 0) { %>
    <div class="row mb-4">
      <div class="col-12">
        <div class="card">
          <div class="card-header bg-warning">
            <h5>Current Bookings (<%= currentBookings.length %>)</h5>
          </div>
          <div class="card-body">
            <div class="table-responsive">
              <table class="table">
                <thead>
                  <tr>
                    <th>Vehicle</th>
                    <th>Renter</th>
                    <th>Pickup Date</th>
                    <th>Return Date</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% currentBookings.forEach(booking => { %>
                    <tr>
                      <td><%= booking.vehicleId?.title || 'N/A' %></td>
                      <td><%= booking.renterId?.username || booking.renterId?.email || 'N/A' %></td>
                      <td><%= booking.pickupDate ? new Date(booking.pickupDate).toLocaleDateString() : 'N/A' %></td>
                      <td><%= booking.returnDate ? new Date(booking.returnDate).toLocaleDateString() : 'N/A' %></td>
                      <td>₹<%= booking.totalPrice?.toLocaleString('en-IN') || 0 %></td>
                      <td><span class="badge bg-warning"><%= booking.bookingStatus %></span></td>
                      <td>
                        <button class="btn btn-sm btn-success" onclick="completeBooking('<%= booking._id %>')">Complete</button>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% } %>

  <!-- Upcoming Bookings -->
  <% if (upcomingBookings.length > 0) { %>
    <div class="row mb-4">
      <div class="col-12">
        <div class="card">
          <div class="card-header bg-info">
            <h5>Upcoming Bookings (<%= upcomingBookings.length %>)</h5>
          </div>
          <div class="card-body">
            <div class="table-responsive">
              <table class="table">
                <thead>
                  <tr>
                    <th>Vehicle</th>
                    <th>Renter</th>
                    <th>Pickup Date</th>
                    <th>Return Date</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% upcomingBookings.forEach(booking => { %>
                    <tr>
                      <td><%= booking.vehicleId?.title || 'N/A' %></td>
                      <td><%= booking.renterId?.username || booking.renterId?.email || 'N/A' %></td>
                      <td><%= booking.pickupDate ? new Date(booking.pickupDate).toLocaleDateString() : 'N/A' %></td>
                      <td><%= booking.returnDate ? new Date(booking.returnDate).toLocaleDateString() : 'N/A' %></td>
                      <td>₹<%= booking.totalPrice?.toLocaleString('en-IN') || 0 %></td>
                      <td><span class="badge bg-info"><%= booking.bookingStatus %></span></td>
                      <td>
                        <button class="btn btn-sm btn-danger" onclick="cancelBooking('<%= booking._id %>')">Cancel</button>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% } %>

  <!-- All Bookings -->
  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          <h5>All Bookings History</h5>
        </div>
        <div class="card-body">
          <% if (bookings.length === 0) { %>
            <p class="text-muted">No bookings yet.</p>
          <% } else { %>
            <div class="table-responsive">
              <table class="table">
                <thead>
                  <tr>
                    <th>Vehicle</th>
                    <th>Renter</th>
                    <th>Pickup Date</th>
                    <th>Return Date</th>
                    <th>Amount</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% bookings.forEach(booking => { %>
                    <tr>
                      <td><%= booking.vehicleId?.title || 'N/A' %></td>
                      <td><%= booking.renterId?.username || booking.renterId?.email || 'N/A' %></td>
                      <td><%= booking.pickupDate ? new Date(booking.pickupDate).toLocaleDateString() : 'N/A' %></td>
                      <td><%= booking.returnDate ? new Date(booking.returnDate).toLocaleDateString() : 'N/A' %></td>
                      <td>₹<%= booking.totalPrice?.toLocaleString('en-IN') || 0 %></td>
                      <td>
                        <span class="badge bg-<%= 
                          booking.bookingStatus === 'COMPLETED' ? 'success' : 
                          booking.bookingStatus === 'CANCELLED' ? 'danger' : 
                          booking.bookingStatus === 'CONFIRMED' ? 'info' : 'secondary' 
                        %>"><%= booking.bookingStatus %></span>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
async function completeBooking(bookingId) {
  const vehicleConditionAfter = prompt('Enter vehicle condition after rental:');
  if (vehicleConditionAfter === null) return;

  try {
    const response = await fetch(`/cars/bookings/${bookingId}/complete`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ vehicleConditionAfter })
    });

    const result = await response.json();
    if (result.success) {
      alert('Booking completed successfully!');
      location.reload();
    } else {
      alert('Failed to complete booking: ' + result.error);
    }
  } catch (error) {
    alert('Error completing booking: ' + error.message);
  }
}

async function cancelBooking(bookingId) {
  if (!confirm('Are you sure you want to cancel this booking?')) return;

  const reason = prompt('Enter cancellation reason (optional):');
  if (reason === null) return;

  try {
    const response = await fetch(`/cars/bookings/${bookingId}/cancel`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ reason })
    });

    const result = await response.json();
    if (result.success) {
      alert('Booking cancelled successfully!');
      location.reload();
    } else {
      alert('Failed to cancel booking: ' + result.error);
    }
  } catch (error) {
    alert('Error cancelling booking: ' + error.message);
  }
}
</script>
