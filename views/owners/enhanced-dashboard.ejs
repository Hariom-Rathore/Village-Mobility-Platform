<% layout("/listings/layouts/boilerplate") %>
<style>
:root {
  --primary: #2563eb;
  --primary-50: #eff6ff;
  --surface: #f8fafc;
  --border: #e2e8f0;
  --border-light: #f1f5f9;
  --text: #1e293b;
  --text-secondary: #64748b;
  --danger: #ef4444;
  --success: #10b981;
  --warning: #f59e0b;
  --radius-lg: 16px;
  --radius-full: 9999px;
  --max-width: 1280px;
}

.enhanced-dashboard {
  display: flex;
  min-height: calc(100vh - 72px);
  background: var(--surface);
}

.sidebar {
  width: 260px;
  background: white;
  border-right: 1px solid var(--border);
  padding: 20px 16px;
  position: fixed;
  height: calc(100vh - 72px);
  overflow-y: auto;
}

.sidebar-brand {
  display: flex;
  align-items: center;
  gap: 12px;
  padding-bottom: 20px;
  border-bottom: 1px solid var(--border);
  margin-bottom: 20px;
}

.sidebar-brand-icon {
  width: 40px;
  height: 40px;
  background: var(--primary);
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 18px;
}

.sidebar-brand-text h3 {
  font-size: 16px;
  font-weight: 700;
  margin: 0;
  color: var(--text);
}

.sidebar-brand-text p {
  font-size: 11px;
  color: var(--text-secondary);
  margin: 0;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 16px;
  border-radius: var(--radius-lg);
  color: var(--text-secondary);
  text-decoration: none;
  font-size: 14px;
  font-weight: 500;
  margin-bottom: 4px;
  transition: all 0.2s;
  cursor: pointer;
}

.nav-item:hover {
  background: var(--surface);
  color: var(--text);
}

.nav-item.active {
  background: var(--primary-50);
  color: var(--primary);
  font-weight: 600;
}

.nav-item i {
  width: 18px;
  text-align: center;
}

.nav-badge {
  margin-left: auto;
  background: var(--primary);
  color: white;
  padding: 2px 8px;
  border-radius: var(--radius-full);
  font-size: 11px;
  font-weight: 600;
}

.main-content {
  flex: 1;
  margin-left: 260px;
  padding: 24px;
}

.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
}

.page-title {
  font-size: 24px;
  font-weight: 700;
  margin: 0;
}

.page-subtitle {
  font-size: 14px;
  color: var(--text-secondary);
  margin-top: 4px;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 16px;
  margin-bottom: 24px;
}

.stat-card {
  background: white;
  border-radius: var(--radius-lg);
  padding: 20px;
  border: 1px solid var(--border-light);
  box-shadow: 0 1px 4px rgba(0,0,0,0.06);
}

.stat-icon {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  margin-bottom: 12px;
  color: white;
}

.stat-value {
  font-size: 28px;
  font-weight: 700;
  color: var(--text);
}

.stat-label {
  font-size: 13px;
  color: var(--text-secondary);
}

.section-card {
  background: white;
  border-radius: var(--radius-lg);
  padding: 24px;
  border: 1px solid var(--border-light);
  box-shadow: 0 1px 4px rgba(0,0,0,0.06);
  margin-bottom: 20px;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}

.section-title {
  font-size: 16px;
  font-weight: 700;
  margin: 0;
}

.data-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 14px;
}

.data-table th {
  text-align: left;
  padding: 12px 16px;
  font-size: 12px;
  font-weight: 600;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 0.3px;
  border-bottom: 2px solid var(--border);
  background: var(--surface);
}

.data-table td {
  padding: 12px 16px;
  border-bottom: 1px solid var(--border-light);
}

.data-table tr:hover td {
  background: var(--surface);
}

.status-badge {
  padding: 4px 12px;
  border-radius: var(--radius-full);
  font-size: 11px;
  font-weight: 600;
}

.status-badge.pending { background: #fef3c7; color: #92400e; }
.status-badge.confirmed { background: #dbeafe; color: #1e40af; }
.status-badge.completed { background: #d1fae5; color: #065f46; }
.status-badge.cancelled { background: #fee2e2; color: #991b1b; }
.status-badge.available { background: #d1fae5; color: #065f46; }
.status-badge.booked { background: #fee2e2; color: #991b1b; }

.btn {
  padding: 8px 16px;
  border-radius: var(--radius-lg);
  border: none;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
}

.btn-primary { background: var(--primary); color: white; }
.btn-primary:hover { background: #1d4ed8; }

.btn-success { background: var(--success); color: white; }
.btn-danger { background: var(--danger); color: white; }
.btn-warning { background: var(--warning); color: white; }

.btn-sm {
  padding: 6px 12px;
  font-size: 12px;
}

.btn-ghost {
  background: transparent;
  color: var(--text);
  border: 1px solid var(--border);
}

.btn-ghost:hover {
  background: var(--surface);
}

.empty-state {
  text-align: center;
  padding: 40px;
  color: var(--text-secondary);
}

.empty-state i {
  font-size: 48px;
  margin-bottom: 16px;
  color: var(--border);
}

@media (max-width: 1024px) {
  .sidebar {
    transform: translateX(-100%);
    transition: transform 0.3s;
  }
  .sidebar.open {
    transform: translateX(0);
  }
  .main-content {
    margin-left: 0;
  }
}
</style>

<div class="enhanced-dashboard">
  <!-- Sidebar -->
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-brand">
      <div class="sidebar-brand-icon">
        <i class="fas fa-car"></i>
      </div>
      <div class="sidebar-brand-text">
        <h3>RideLocal</h3>
        <p>Owner Console</p>
      </div>
    </div>

    <nav>
      <a href="/owners/dashboard" class="nav-item active" data-section="overview">
        <i class="fas fa-chart-line"></i>
        <span>Dashboard (डैशबोर्ड)</span>
      </a>
      <a href="/owners/my-vehicles-enhanced" class="nav-item" data-section="vehicles">
        <i class="fas fa-car"></i>
        <span>My Vehicles (वाहन)</span>
        <span class="nav-badge" id="vehicleCount">0</span>
      </a>
      <a href="/owners/bookings" class="nav-item" data-section="bookings">
        <i class="fas fa-calendar-check"></i>
        <span>Bookings (बुकिंग)</span>
        <span class="nav-badge" id="pendingCount">0</span>
      </a>
      <a href="/owners/drivers" class="nav-item" data-section="drivers">
        <i class="fas fa-user-tie"></i>
        <span>Drivers (ड्राइवर)</span>
      </a>
      <a href="/owners/documents" class="nav-item" data-section="documents">
        <i class="fas fa-file-alt"></i>
        <span>Documents (दस्तावेज)</span>
      </a>
      <a href="/owners/analytics" class="nav-item" data-section="analytics">
        <i class="fas fa-chart-bar"></i>
        <span>Analytics (विश्लेषण)</span>
      </a>
      <a href="/owners/reviews" class="nav-item" data-section="reviews">
        <i class="fas fa-star"></i>
        <span>Reviews (समीक्षा)</span>
        <span class="nav-badge" id="reviewCount">0</span>
      </a>
      <a href="/owners/settings" class="nav-item" data-section="settings">
        <i class="fas fa-cog"></i>
        <span>Settings (सेटिंग्स)</span>
      </a>
    </nav>
  </aside>

  <!-- Main Content -->
  <main class="main-content">
    <div class="page-header">
      <div>
        <h1 class="page-title">Dashboard (डैशबोर्ड)</h1>
        <p class="page-subtitle">Welcome back, <%= currUser ? currUser.username : 'Owner' %></p>
      </div>
      <div>
        <button class="btn btn-primary" onclick="window.location.href='/owners/new-vehicle'">
          <i class="fas fa-plus me-2"></i> Add Vehicle
        </button>
      </div>
    </div>

    <!-- Stats Grid -->
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-icon" style="background: #2563eb;">
          <i class="fas fa-car"></i>
        </div>
        <div class="stat-value" id="totalVehicles">0</div>
        <div class="stat-label">Total Vehicles</div>
      </div>
      <div class="stat-card">
        <div class="stat-icon" style="background: #f59e0b;">
          <i class="fas fa-clock"></i>
        </div>
        <div class="stat-value" id="pendingBookings">0</div>
        <div class="stat-label">Pending Requests</div>
      </div>
      <div class="stat-card">
        <div class="stat-icon" style="background: #10b981;">
          <i class="fas fa-calendar-check"></i>
        </div>
        <div class="stat-value" id="completedTrips">0</div>
        <div class="stat-label">Completed Trips</div>
      </div>
      <div class="stat-card">
        <div class="stat-icon" style="background: #8b5cf6;">
          <i class="fas fa-wallet"></i>
        </div>
        <div class="stat-value" id="totalRevenue">₹0</div>
        <div class="stat-label">Total Revenue</div>
      </div>
      <div class="stat-card">
        <div class="stat-icon" style="background: #ec4899;">
          <i class="fas fa-star"></i>
        </div>
        <div class="stat-value" id="avgRating">0.0</div>
        <div class="stat-label">Average Rating</div>
      </div>
      <div class="stat-card">
        <div class="stat-icon" style="background: #06b6d4;">
          <i class="fas fa-route"></i>
        </div>
        <div class="stat-value" id="totalTrips">0</div>
        <div class="stat-label">Total Trips</div>
      </div>
    </div>

    <!-- Pending Booking Requests -->
    <div class="section-card" style="border-left: 4px solid #f59e0b;">
      <div class="section-header">
        <h2 class="section-title">Pending Booking Requests (<span id="pendingRequestsCount">0</span>)</h2>
        <a href="/owners/bookings?status=PENDING" class="btn btn-ghost btn-sm">View All</a>
      </div>
      <div id="pendingBookingsContainer"></div>
      <div id="emptyPending" class="empty-state" style="display: none;">
        <i class="fas fa-inbox"></i>
        <p>No pending booking requests</p>
      </div>
    </div>

    <!-- Active Bookings -->
    <div class="section-card" style="border-left: 4px solid #10b981;">
      <div class="section-header">
        <h2 class="section-title">Active Bookings (<span id="activeBookingsCount">0</span>)</h2>
        <a href="/owners/bookings?status=CONFIRMED" class="btn btn-ghost btn-sm">View All</a>
      </div>
      <div id="activeBookingsContainer"></div>
      <div id="emptyActive" class="empty-state" style="display: none;">
        <i class="fas fa-calendar"></i>
        <p>No active bookings</p>
      </div>
    </div>

    <!-- Recent Vehicles -->
    <div class="section-card" style="border-left: 4px solid #2563eb;">
      <div class="section-header">
        <h2 class="section-title">My Vehicles (<span id="recentVehiclesCount">0</span>)</h2>
        <a href="/owners/my-vehicles" class="btn btn-ghost btn-sm">View All</a>
      </div>
      <div id="vehiclesContainer"></div>
      <div id="emptyVehicles" class="empty-state" style="display: none;">
        <i class="fas fa-car"></i>
        <p>No vehicles added yet</p>
      </div>
    </div>

    <!-- Recent Reviews -->
    <div class="section-card" style="border-left: 4px solid #ec4899;">
      <div class="section-header">
        <h2 class="section-title">Recent Reviews (<span id="recentReviewsCount">0</span>)</h2>
        <a href="/owners/reviews" class="btn btn-ghost btn-sm">View All</a>
      </div>
      <div id="reviewsContainer"></div>
      <div id="emptyReviews" class="empty-state" style="display: none;">
        <i class="fas fa-star"></i>
        <p>No reviews yet</p>
      </div>
    </div>
  </main>
</div>

<script>
async function loadDashboardStats() {
  try {
    const res = await fetch('/owners/api/dashboard-stats');
    const data = await res.json();
    
    if (data.success) {
      document.getElementById('totalVehicles').textContent = data.stats.totalVehicles || 0;
      document.getElementById('pendingBookings').textContent = data.stats.pendingBookings || 0;
      document.getElementById('completedTrips').textContent = data.stats.completedTrips || 0;
      document.getElementById('totalRevenue').textContent = '₹' + (data.stats.totalRevenue || 0).toLocaleString('en-IN');
      document.getElementById('avgRating').textContent = (data.stats.averageRating || 0).toFixed(1);
      document.getElementById('totalTrips').textContent = data.stats.totalTrips || 0;
      
      document.getElementById('vehicleCount').textContent = data.stats.totalVehicles || 0;
      document.getElementById('pendingCount').textContent = data.stats.pendingBookings || 0;
      document.getElementById('reviewCount').textContent = data.stats.totalReviews || 0;
    }
  } catch (error) {
    console.error('Error loading stats:', error);
  }
}

async function loadPendingBookings() {
  const container = document.getElementById('pendingBookingsContainer');
  const empty = document.getElementById('emptyPending');
  
  try {
    const res = await fetch('/owners/api/bookings?status=PENDING&limit=5');
    const data = await res.json();
    
    if (!data.success || !data.bookings?.length) {
      empty.style.display = 'block';
      return;
    }
    
    document.getElementById('pendingRequestsCount').textContent = data.bookings.length;
    
    data.bookings.forEach(booking => {
      const renter = booking.renterId || {};
      const vehicle = booking.vehicleId || {};
      const div = document.createElement('div');
      div.innerHTML = `
        <table class="data-table">
          <tr>
            <td><strong>${renter.username || 'Customer'}</strong><br><small>${booking.passengers || 1} passengers</small></td>
            <td><small>${booking.pickup || booking.pickupLocation || 'N/A'} → ${booking.destination || 'N/A'}</small><br><small class="text-secondary">${booking.pickupDate ? new Date(booking.pickupDate).toLocaleDateString() : 'N/A'} at ${booking.pickupTime || 'N/A'}</small></td>
            <td><strong>₹${(booking.estimatedFare || booking.totalPrice || 0).toLocaleString('en-IN')}</strong></td>
            <td>
              <div class="flex gap-2">
                <button class="btn btn-success btn-sm" onclick="acceptBooking('${booking._id}')"><i class="fas fa-check"></i> Accept</button>
                <button class="btn btn-danger btn-sm" onclick="rejectBooking('${booking._id}')"><i class="fas fa-times"></i> Reject</button>
                <button class="btn btn-warning btn-sm" onclick="openCounterOffer('${booking._id}')"><i class="fas fa-handshake"></i> Counter</button>
              </div>
            </td>
          </tr>
        </table>
      `;
      container.appendChild(div);
    });
  } catch (error) {
    empty.style.display = 'block';
  }
}

async function loadActiveBookings() {
  const container = document.getElementById('activeBookingsContainer');
  const empty = document.getElementById('emptyActive');
  
  try {
    const res = await fetch('/owners/api/bookings?status=CONFIRMED&limit=5');
    const data = await res.json();
    
    if (!data.success || !data.bookings?.length) {
      empty.style.display = 'block';
      return;
    }
    
    document.getElementById('activeBookingsCount').textContent = data.bookings.length;
    
    data.bookings.forEach(booking => {
      const renter = booking.renterId || {};
      const vehicle = booking.vehicleId || {};
      const div = document.createElement('div');
      div.innerHTML = `
        <table class="data-table">
          <tr>
            <td><strong>${vehicle.title || vehicle.vehicleName || 'Vehicle'}</strong></td>
            <td>${renter.username || 'Customer'}</td>
            <td>${booking.pickupDate ? new Date(booking.pickupDate).toLocaleDateString() : 'N/A'}</td>
            <td><strong>₹${(booking.totalPrice || booking.estimatedFare || 0).toLocaleString('en-IN')}</strong></td>
            <td><button class="btn btn-success btn-sm" onclick="completeBooking('${booking._id}')"><i class="fas fa-check-circle"></i> Complete</button></td>
          </tr>
        </table>
      `;
      container.appendChild(div);
    });
  } catch (error) {
    empty.style.display = 'block';
  }
}

async function loadRecentVehicles() {
  const container = document.getElementById('vehiclesContainer');
  const empty = document.getElementById('emptyVehicles');
  
  try {
    const res = await fetch('/owners/api/vehicles?limit=5');
    const data = await res.json();
    
    if (!data.success || !data.vehicles?.length) {
      empty.style.display = 'block';
      return;
    }
    
    document.getElementById('recentVehiclesCount').textContent = data.vehicles.length;
    
    data.vehicles.forEach(vehicle => {
      const div = document.createElement('div');
      div.innerHTML = `
        <table class="data-table">
          <tr>
            <td><strong>${vehicle.title || vehicle.vehicleName || 'Vehicle'}</strong><br><small>${vehicle.brand || ''} ${vehicle.model || ''}</small></td>
            <td>${vehicle.location || vehicle.city || 'N/A'}</td>
            <td><span class="status-badge ${vehicle.availabilityStatus === 'AVAILABLE' ? 'available' : 'booked'}">${vehicle.availabilityStatus || 'UNKNOWN'}</span></td>
            <td><strong>₹${(vehicle.price || vehicle.ratePerKm || 0).toLocaleString('en-IN')}</strong>${vehicle.ratePerKm ? '/km' : '/day'}</td>
            <td><a href="/owners/vehicles/${vehicle._id}" class="btn btn-ghost btn-sm"><i class="fas fa-edit"></i> Edit</a></td>
          </tr>
        </table>
      `;
      container.appendChild(div);
    });
  } catch (error) {
    empty.style.display = 'block';
  }
}

async function loadRecentReviews() {
  const container = document.getElementById('reviewsContainer');
  const empty = document.getElementById('emptyReviews');
  
  try {
    const res = await fetch('/owners/api/reviews?limit=5');
    const data = await res.json();
    
    if (!data.success || !data.reviews?.length) {
      empty.style.display = 'block';
      return;
    }
    
    document.getElementById('recentReviewsCount').textContent = data.reviews.length;
    
    data.reviews.forEach(review => {
      const div = document.createElement('div');
      div.innerHTML = `
        <table class="data-table">
          <tr>
            <td><strong>${review.author?.username || 'Customer'}</strong></td>
            <td><span class="status-badge" style="background: #fef3c7; color: #92400e;"><i class="fas fa-star"></i> ${review.rating || 0}</span></td>
            <td><small>${review.comment || review.reviewText || 'No comment'}</small></td>
            <td><small>${review.createdAt ? new Date(review.createdAt).toLocaleDateString() : 'N/A'}</small></td>
          </tr>
        </table>
      `;
      container.appendChild(div);
    });
  } catch (error) {
    empty.style.display = 'block';
  }
}

async function acceptBooking(id) {
  if (!confirm('Accept this booking request?')) return;
  try {
    const res = await fetch(`/owners/api/bookings/${id}/accept`, { method: 'POST' });
    const data = await res.json();
    if (data.success) {
      alert('Booking accepted successfully');
      location.reload();
    } else {
      alert(data.error || 'Failed to accept booking');
    }
  } catch (error) {
    alert('Error accepting booking');
  }
}

async function rejectBooking(id) {
  if (!confirm('Reject this booking request?')) return;
  try {
    const res = await fetch(`/owners/api/bookings/${id}/reject`, { 
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ reason: 'Rejected by owner' })
    });
    const data = await res.json();
    if (data.success) {
      alert('Booking rejected');
      location.reload();
    } else {
      alert(data.error || 'Failed to reject booking');
    }
  } catch (error) {
    alert('Error rejecting booking');
  }
}

async function completeBooking(id) {
  if (!confirm('Mark this booking as completed?')) return;
  try {
    const res = await fetch(`/owners/api/bookings/${id}/complete`, { method: 'POST' });
    const data = await res.json();
    if (data.success) {
      alert('Booking completed');
      location.reload();
    } else {
      alert(data.error || 'Failed to complete booking');
    }
  } catch (error) {
    alert('Error completing booking');
  }
}

function openCounterOffer(id) {
  // Implement counter offer modal
  alert('Counter offer functionality - to be implemented');
}

document.addEventListener('DOMContentLoaded', () => {
  loadDashboardStats();
  loadPendingBookings();
  loadActiveBookings();
  loadRecentVehicles();
  loadRecentReviews();
});
</script>
