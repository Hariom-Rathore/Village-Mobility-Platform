<% layout("/listings/layouts/boilerplate") %>

<style>
.owner-bookings {
    padding: 20px;
    max-width: 1200px;
    margin: 0 auto;
}

.page-header {
    margin-bottom: 24px;
}

.page-title {
    font-size: 28px;
    font-weight: 700;
    color: #333;
    margin-bottom: 8px;
}

.page-subtitle {
    color: #666;
    font-size: 14px;
}

.tabs-container {
    background: white;
    border-radius: 12px;
    padding: 16px;
    margin-bottom: 24px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}

.tabs {
    display: flex;
    gap: 8px;
    border-bottom: 2px solid #f3f4f6;
    padding-bottom: 12px;
}

.tab {
    padding: 10px 20px;
    border: none;
    background: none;
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
    color: #666;
    border-radius: 8px;
    transition: all 0.3s;
}

.tab:hover {
    background: #f3f4f6;
}

.tab.active {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
}

.bookings-grid {
    display: grid;
    gap: 16px;
}

.booking-card {
    background: white;
    border-radius: 12px;
    padding: 20px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    transition: all 0.3s;
}

.booking-card:hover {
    box-shadow: 0 4px 16px rgba(0,0,0,0.1);
}

.booking-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
}

.booking-customer {
    display: flex;
    align-items: center;
    gap: 12px;
}

.customer-avatar {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-weight: 600;
    font-size: 18px;
}

.customer-info h4 {
    font-size: 16px;
    font-weight: 700;
    margin: 0 0 4px 0;
    color: #333;
}

.customer-info p {
    font-size: 13px;
    color: #666;
    margin: 0;
}

.status-badge {
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
}

.status-pending {
    background: #fef3c7;
    color: #92400e;
}

.status-accepted {
    background: #d1fae5;
    color: #065f46;
}

.status-completed {
    background: #dbeafe;
    color: #1e40af;
}

.status-cancelled {
    background: #fee2e2;
    color: #991b1b;
}

.status-rejected {
    background: #f3f4f6;
    color: #4b5563;
}

.status-counter-offered {
    background: #fef3c7;
    color: #92400e;
}

.booking-route {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    padding: 12px;
    background: #f9fafb;
    border-radius: 8px;
}

.route-point {
    flex: 1;
}

.route-point label {
    font-size: 12px;
    color: #999;
    margin-bottom: 4px;
}

.route-point span {
    font-size: 14px;
    font-weight: 600;
    color: #333;
}

.route-arrow {
    color: #667eea;
    font-size: 20px;
}

.booking-details {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 16px;
    margin-bottom: 16px;
}

.booking-detail {
    display: flex;
    flex-direction: column;
}

.booking-detail label {
    font-size: 12px;
    color: #999;
    margin-bottom: 4px;
}

.booking-detail span {
    font-size: 14px;
    font-weight: 600;
    color: #333;
}

.booking-price {
    font-size: 24px;
    font-weight: 700;
    color: #667eea;
    margin-bottom: 16px;
}

.counter-offer-section {
    background: #fef3c7;
    border-radius: 8px;
    padding: 12px;
    margin-bottom: 16px;
}

.counter-offer-section h5 {
    font-size: 14px;
    font-weight: 600;
    color: #92400e;
    margin: 0 0 8px 0;
}

.counter-offer-details {
    display: flex;
    gap: 16px;
    font-size: 13px;
    color: #92400e;
}

.booking-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
}

.btn-action {
    padding: 10px 20px;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s;
}

.btn-primary {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
}

.btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
}

.btn-secondary {
    background: #f3f4f6;
    color: #333;
}

.btn-secondary:hover {
    background: #e5e7eb;
}

.btn-success {
    background: #10b981;
    color: white;
}

.btn-success:hover {
    background: #059669;
}

.btn-danger {
    background: #fee2e2;
    color: #991b1b;
}

.btn-danger:hover {
    background: #fecaca;
}

.btn-warning {
    background: #fef3c7;
    color: #92400e;
}

.btn-warning:hover {
    background: #fde68a;
}

.empty-state {
    text-align: center;
    padding: 60px 20px;
    color: #999;
}

.empty-state i {
    font-size: 48px;
    margin-bottom: 16px;
}

@media (max-width: 768px) {
    .owner-bookings {
        padding: 12px;
    }
    
    .tabs {
        overflow-x: auto;
        padding-bottom: 8px;
    }
    
    .tab {
        white-space: nowrap;
    }
    
    .booking-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
    }
    
    .booking-details {
        grid-template-columns: 1fr;
    }
    
    .booking-route {
        flex-direction: column;
        align-items: flex-start;
    }
    
    .route-arrow {
        transform: rotate(90deg);
    }
    
    .booking-actions {
        flex-direction: column;
        width: 100%;
    }
    
    .btn-action {
        width: 100%;
    }
}
</style>

<div class="owner-bookings">
    <div class="page-header">
        <h1 class="page-title">Bookings</h1>
        <p class="page-subtitle">Manage your vehicle bookings</p>
    </div>

    <!-- Tabs -->
    <div class="tabs-container">
        <div class="tabs">
            <button class="tab active" onclick="switchTab('pending')">Pending</button>
            <button class="tab" onclick="switchTab('accepted')">Accepted</button>
            <button class="tab" onclick="switchTab('completed')">Completed</button>
        </div>
    </div>

    <!-- Bookings Container -->
    <div id="bookingsContainer" class="bookings-grid">
        <!-- Bookings will be loaded here -->
    </div>
    
    <div id="emptyState" class="empty-state" style="display: none;">
        <i class="fas fa-inbox"></i>
        <h3>No bookings found</h3>
        <p>You don't have any bookings in this category</p>
    </div>
    
    <div id="loadingState" class="empty-state" style="display: none;">
        <i class="fas fa-spinner fa-spin"></i>
        <h3>Loading bookings...</h3>
    </div>
</div>

<script>
let currentTab = 'pending';

async function loadBookings(tab) {
    const container = document.getElementById('bookingsContainer');
    const emptyState = document.getElementById('emptyState');
    const loadingState = document.getElementById('loadingState');
    
    loadingState.style.display = 'block';
    container.innerHTML = '';
    
    try {
        let status = '';
        if (tab === 'pending') {
            status = 'PENDING,PENDING_OWNER_APPROVAL,COUNTER_OFFERED';
        } else if (tab === 'accepted') {
            status = 'ACCEPTED,CONFIRMED';
        } else if (tab === 'completed') {
            status = 'COMPLETED';
        }
        
        const response = await fetch(`/bookings/owner?status=${status}`);
        const data = await response.json();
        
        loadingState.style.display = 'none';
        
        if (!data.success || !data.bookings || data.bookings.length === 0) {
            emptyState.style.display = 'block';
            return;
        }
        
        data.bookings.forEach(booking => {
            const bookingCard = createBookingCard(booking);
            container.appendChild(bookingCard);
        });
    } catch (error) {
        console.error('Error loading bookings:', error);
        loadingState.style.display = 'none';
        emptyState.style.display = 'block';
    }
}

function createBookingCard(booking) {
    const card = document.createElement('div');
    card.className = 'booking-card';
    
    const customer = booking.renterId || {};
    const customerName = customer.username || 'Customer';
    const customerInitial = customerName.charAt(0).toUpperCase();
    
    const statusClass = getStatusClass(booking.bookingStatus);
    const statusText = formatStatus(booking.bookingStatus);
    
    card.innerHTML = `
        <div class="booking-header">
            <div class="booking-customer">
                <div class="customer-avatar">${customerInitial}</div>
                <div class="customer-info">
                    <h4>${customerName}</h4>
                    <p>${customer.email || 'No email'}</p>
                </div>
            </div>
            <span class="status-badge ${statusClass}">${statusText}</span>
        </div>
        
        <div class="booking-route">
            <div class="route-point">
                <label><i class="fas fa-map-marker-alt"></i> Pickup</label>
                <span>${booking.pickup || 'Not specified'}</span>
            </div>
            <div class="route-arrow"><i class="fas fa-arrow-right"></i></div>
            <div class="route-point">
                <label><i class="fas fa-flag-checkered"></i> Destination</label>
                <span>${booking.destination || 'Not specified'}</span>
            </div>
        </div>
        
        <div class="booking-details">
            <div class="booking-detail">
                <label>Date & Time</label>
                <span>${formatDateTime(booking.pickupDate, booking.pickupTime)}</span>
            </div>
            <div class="booking-detail">
                <label>Passengers</label>
                <span>${booking.passengers || 'N/A'}</span>
            </div>
            <div class="booking-detail">
                <label>Trip Type</label>
                <span>${formatTripType(booking.tripType)}</span>
            </div>
            <div class="booking-detail">
                <label>Distance</label>
                <span>${booking.distanceKm || 'N/A'} km</span>
            </div>
            <div class="booking-detail">
                <label>Payment Method</label>
                <span>${formatPaymentMethod(booking.paymentMethod)}</span>
            </div>
        </div>
        
        ${booking.bookingStatus === 'COUNTER_OFFERED' ? `
            <div class="counter-offer-section">
                <h5><i class="fas fa-exclamation-triangle"></i> Counter Offer Pending</h5>
                <div class="counter-offer-details">
                    <span>Original: ₹${booking.totalPrice || 0}</span>
                    <span>New: ₹${booking.counterOffer?.totalFare || 0}</span>
                </div>
            </div>
        ` : ''}
        
        <div class="booking-price">
            ₹${booking.bookingStatus === 'COUNTER_OFFERED' ? (booking.counterOffer?.totalFare || booking.totalPrice) : (booking.totalPrice || booking.estimatedFare || 0)}
        </div>
        
        ${getBookingActions(booking)}
    `;
    
    return card;
}

function getBookingActions(booking) {
    const status = booking.bookingStatus;
    
    if (status === 'PENDING' || status === 'PENDING_OWNER_APPROVAL') {
        return `
            <div class="booking-actions">
                <button class="btn-action btn-success" onclick="acceptBooking('${booking._id}')">
                    <i class="fas fa-check"></i> Accept
                </button>
                <button class="btn-action btn-danger" onclick="rejectBooking('${booking._id}')">
                    <i class="fas fa-times"></i> Reject
                </button>
                <button class="btn-action btn-warning" onclick="sendCounterOffer('${booking._id}')">
                    <i class="fas fa-exchange-alt"></i> Counter Offer
                </button>
            </div>
        `;
    }
    
    if (status === 'COUNTER_OFFERED') {
        return `
            <div class="booking-actions">
                <button class="btn-action btn-secondary" onclick="viewDetails('${booking._id}')">
                    <i class="fas fa-eye"></i> View Details
                </button>
            </div>
        `;
    }
    
    if (status === 'ACCEPTED' || status === 'CONFIRMED') {
        return `
            <div class="booking-actions">
                <button class="btn-action btn-secondary" onclick="viewDetails('${booking._id}')">
                    <i class="fas fa-eye"></i> View Details
                </button>
                <button class="btn-action btn-primary" onclick="completeBooking('${booking._id}')">
                    <i class="fas fa-check-circle"></i> Complete Trip
                </button>
            </div>
        `;
    }
    
    if (status === 'COMPLETED') {
        return `
            <div class="booking-actions">
                <button class="btn-action btn-secondary" onclick="viewDetails('${booking._id}')">
                    <i class="fas fa-eye"></i> View Details
                </button>
            </div>
        `;
    }
    
    return '';
}

function getStatusClass(status) {
    const statusMap = {
        'PENDING': 'status-pending',
        'PENDING_OWNER_APPROVAL': 'status-pending',
        'ACCEPTED': 'status-accepted',
        'CONFIRMED': 'status-accepted',
        'COMPLETED': 'status-completed',
        'CANCELLED': 'status-cancelled',
        'REJECTED': 'status-rejected',
        'COUNTER_OFFERED': 'status-counter-offered'
    };
    return statusMap[status] || 'status-pending';
}

function formatStatus(status) {
    const statusMap = {
        'PENDING': 'Pending',
        'PENDING_OWNER_APPROVAL': 'Pending',
        'ACCEPTED': 'Accepted',
        'CONFIRMED': 'Confirmed',
        'COMPLETED': 'Completed',
        'CANCELLED': 'Cancelled',
        'REJECTED': 'Rejected',
        'COUNTER_OFFERED': 'Counter Offer'
    };
    return statusMap[status] || status;
}

function formatDateTime(date, time) {
    if (!date) return 'Not specified';
    const dateObj = new Date(date);
    const dateStr = dateObj.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
    const timeStr = time || 'Not specified';
    return `${dateStr} at ${timeStr}`;
}

function formatTripType(type) {
    if (!type) return 'Not specified';
    return type.split('-').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');
}

function formatPaymentMethod(method) {
    if (!method) return 'Not specified';
    const methodMap = {
        'cash': 'Cash',
        'upi': 'UPI',
        'online': 'Online',
        'razorpay': 'Online Payment',
        'cod': 'Cash on Delivery'
    };
    return methodMap[method] || method;
}

function switchTab(tab) {
    currentTab = tab;
    
    // Update tab styles
    document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
    event.target.classList.add('active');
    
    // Load bookings for the selected tab
    loadBookings(tab);
}

async function acceptBooking(bookingId) {
    if (!confirm('Are you sure you want to accept this booking?')) return;
    
    try {
        const response = await fetch(`/bookings/accept/${bookingId}`, {
            method: 'PUT'
        });
        
        const data = await response.json();
        
        if (data.success) {
            alert('Booking accepted successfully!');
            loadBookings(currentTab);
        } else {
            alert('Failed to accept booking: ' + data.error);
        }
    } catch (error) {
        console.error('Error accepting booking:', error);
        alert('Failed to accept booking');
    }
}

async function rejectBooking(bookingId) {
    const reason = prompt('Please enter rejection reason:');
    if (!reason) return;
    
    try {
        const response = await fetch(`/bookings/reject/${bookingId}`, {
            method: 'PUT',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ reason })
        });
        
        const data = await response.json();
        
        if (data.success) {
            alert('Booking rejected successfully!');
            loadBookings(currentTab);
        } else {
            alert('Failed to reject booking: ' + data.error);
        }
    } catch (error) {
        console.error('Error rejecting booking:', error);
        alert('Failed to reject booking');
    }
}

async function sendCounterOffer(bookingId) {
    const baseFare = prompt('Enter new base fare:');
    const totalFare = prompt('Enter new total fare:');
    const message = prompt('Enter message (optional):');
    
    if (!baseFare || !totalFare) {
        alert('Please enter both base fare and total fare');
        return;
    }
    
    try {
        const response = await fetch(`/bookings/counter-offer/${bookingId}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ baseFare, totalFare, message })
        });
        
        const data = await response.json();
        
        if (data.success) {
            alert('Counter offer sent successfully!');
            loadBookings(currentTab);
        } else {
            alert('Failed to send counter offer: ' + data.error);
        }
    } catch (error) {
        console.error('Error sending counter offer:', error);
        alert('Failed to send counter offer');
    }
}

async function completeBooking(bookingId) {
    if (!confirm('Are you sure you want to mark this trip as completed?')) return;
    
    try {
        const response = await fetch(`/bookings/${bookingId}`, {
            method: 'PUT',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({})
        });
        
        const data = await response.json();
        
        if (data.success) {
            alert('Trip marked as completed!');
            loadBookings(currentTab);
        } else {
            alert('Failed to complete trip: ' + data.error);
        }
    } catch (error) {
        console.error('Error completing booking:', error);
        alert('Failed to complete trip');
    }
}

function viewDetails(bookingId) {
    // Navigate to booking details page
    window.location.href = `/bookings/${bookingId}`;
}

// Load pending bookings on page load
document.addEventListener('DOMContentLoaded', () => {
    loadBookings('pending');
});
</script>
