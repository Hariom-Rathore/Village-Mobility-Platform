<nav class="navbar navbar-expand-md bg-white border-bottom sticky-top" style="height:64px;">
  <div class="container-fluid px-3">
    <a class="navbar-brand fw-bold fs-5" href="/" style="color:#2563eb;">
      <i class="fa-solid fa-car me-1"></i> RideLocal
    </a>
    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav me-auto gap-1">
        <% if(!currUser) { %>
          <li class="nav-item"><a class="nav-link rounded-pill px-3" href="/customers/home"><i class="fas fa-home me-1"></i>Home</a></li>
          <li class="nav-item"><a class="nav-link rounded-pill px-3" href="/cars">Vehicles</a></li>
        <% } else if(currUser.role === 'customer') { %>
          <li class="nav-item"><a class="nav-link rounded-pill px-3 <%= req.path === '/customers/home' ? 'active bg-light fw-semibold' : '' %>" href="/customers/home"><i class="fas fa-home me-1"></i>Home</a></li>
          <li class="nav-item"><a class="nav-link rounded-pill px-3 <%= req.path === '/customers/my-trips' ? 'active bg-light fw-semibold' : '' %>" href="/customers/my-trips"><i class="fas fa-route me-1"></i>My Trips</a></li>
          <li class="nav-item"><a class="nav-link rounded-pill px-3 position-relative" href="/notifications"><i class="fas fa-bell me-1"></i>Notifications <span class="badge bg-danger rounded-pill" id="navUnreadCount" style="display:none;font-size:10px;">0</span></a></li>
          <li class="nav-item"><a class="nav-link rounded-pill px-3 <%= req.path === '/users/profile' ? 'active bg-light fw-semibold' : '' %>" href="/users/profile"><i class="fas fa-user me-1"></i>Profile</a></li>
        <% } else if(currUser.role === 'owner') { %>
          <li class="nav-item"><a class="nav-link rounded-pill px-3 <%= req.path === '/owners/dashboard' ? 'active bg-light fw-semibold' : '' %>" href="/owners/dashboard"><i class="fas fa-chart-simple me-1"></i>Dashboard</a></li>
          <li class="nav-item"><a class="nav-link rounded-pill px-3 <%= req.path === '/owners/my-vehicles' ? 'active bg-light fw-semibold' : '' %>" href="/owners/my-vehicles"><i class="fas fa-car me-1"></i>My Vehicles</a></li>
          <li class="nav-item"><a class="nav-link rounded-pill px-3 <%= req.path === '/owners/bookings' ? 'active bg-light fw-semibold' : '' %>" href="/owners/bookings"><i class="fas fa-calendar-check me-1"></i>Bookings</a></li>
          <li class="nav-item"><a class="nav-link rounded-pill px-3 position-relative" href="/notifications"><i class="fas fa-bell me-1"></i>Notifications <span class="badge bg-danger rounded-pill" id="navUnreadCount" style="display:none;font-size:10px;">0</span></a></li>
          <li class="nav-item"><a class="nav-link rounded-pill px-3 <%= req.path === '/users/profile' ? 'active bg-light fw-semibold' : '' %>" href="/users/profile"><i class="fas fa-user me-1"></i>Profile</a></li>
        <% } %>
      </ul>
      <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">
        <% if(!currUser) { %>
           <a class="btn btn-outline-primary btn-sm rounded-pill px-4" href="/users/login">Log in</a>
           <a class="btn btn-primary btn-sm rounded-pill px-4" href="/users/signup">Sign up</a>
        <% } else { %>
          <span class="text-muted small me-2 d-none d-md-inline"><%= currUser.username %></span>
           <a class="btn btn-outline-secondary btn-sm rounded-pill" href="/users/logout">Log out</a>
        <% } %>
      </div>
    </div>
  </div>
</nav>

<script src="https://cdn.socket.io/4.7.5/socket.io.min.js"></script>
<script>
(function() {
  const badge = document.getElementById('navUnreadCount');
  if (!badge) return;

  async function fetchUnreadCount() {
    try {
      const res = await fetch('/owners/api/unread-count');
      const data = await res.json();
      if (data.success && data.unreadCount > 0) {
        badge.textContent = data.unreadCount > 99 ? '99+' : data.unreadCount;
        badge.style.display = 'inline-block';
      } else {
        badge.style.display = 'none';
      }
    } catch(e) {}
  }

  fetchUnreadCount();
  setInterval(fetchUnreadCount, 15000);

  // Socket.IO real-time updates
  try {
    const socket = io();
    socket.on('connect', function() {
      const userId = '<%= (currUser && currUser._id) || "" %>';
      if (userId) socket.emit('join', userId);
    });
    socket.on('new_notification', function() {
      fetchUnreadCount();
    });
  } catch(e) {}
})();
</script>