<% layout("/listings/layouts/boilerplate") %>
<style>
* { margin:0; padding:0; box-sizing:border-box; }
body { background:#f0f2f5; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif; }

.page { max-width:480px; margin:0 auto; padding:16px; }

/* Profile Card */
.profile-card { background:#fff; border-radius:20px; overflow:hidden; box-shadow:0 2px 8px rgba(0,0,0,0.04); margin-bottom:14px; }

/* Cover + Avatar */
.cover-area { background:linear-gradient(135deg,#1e3a5f,#2563eb); height:80px; position:relative; }
.avatar-wrap { position:absolute; bottom:-40px; left:50%; transform:translateX(-50%); }
.avatar { width:80px; height:80px; border-radius:50%; object-fit:cover; background:#fff; border:4px solid #fff; display:flex; align-items:center; justify-content:center; font-size:32px; font-weight:700; color:#2563eb; overflow:hidden; }
.avatar img { width:100%; height:100%; object-fit:cover; }

.info-section { text-align:center; padding:48px 16px 20px; }
.info-section h2 { font-size:22px; font-weight:800; color:#0f172a; }
.info-section .email { font-size:13px; color:#64748b; margin:2px 0 8px; }
.info-section .role-badge { display:inline-block; padding:4px 14px; border-radius:20px; font-size:12px; font-weight:600; background:#dbeafe; color:#1e40af; margin-bottom:4px; }
.info-section .phone { font-size:13px; color:#94a3b8; }
.info-section .phone i { margin-right:4px; }

/* Stats Row */
.stats-row { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; padding:16px; background:#f8fafc; margin:0 16px 16px; border-radius:14px; text-align:center; }
.stat-box .num { font-size:22px; font-weight:800; color:#2563eb; }
.stat-box .lbl { font-size:11px; color:#64748b; margin-top:2px; }

/* Edit Form */
.form-section { padding:0 16px 16px; }
.form-group { margin-bottom:14px; }
.form-group label { display:block; font-size:12px; font-weight:600; color:#64748b; margin-bottom:4px; }
.form-group .input-wrap { display:flex; align-items:center; background:#f8fafc; border:2px solid #e2e8f0; border-radius:12px; padding:0 12px; transition:border-color .2s; }
.form-group .input-wrap:focus-within { border-color:#2563eb; background:#fff; }
.form-group .input-wrap .icon { color:#94a3b8; font-size:14px; width:24px; text-align:center; flex-shrink:0; }
.form-group .input-wrap input,.form-group .input-wrap textarea { flex:1; border:none; background:transparent; padding:12px 8px; font-size:14px; outline:none; }
.form-group .input-wrap input::placeholder { color:#94a3b8; }
.form-group .input-wrap textarea { resize:vertical; min-height:60px; font-family:inherit; }

.btn-save { width:100%; background:#2563eb; color:#fff; border:none; border-radius:14px; padding:14px; font-size:15px; font-weight:700; cursor:pointer; transition:all .15s; }
.btn-save:hover { background:#1d4ed8; transform:translateY(-1px); }

/* Logout */
.logout-section { padding:0 16px 16px; }
.btn-logout { width:100%; background:#fef2f2; color:#dc2626; border:2px solid #fecaca; border-radius:14px; padding:12px; font-size:15px; font-weight:600; cursor:pointer; transition:all .15s; }
.btn-logout:hover { background:#fee2e2; }
</style>

<div class="page">
  <!-- Profile Card -->
  <div class="profile-card">
    <div class="cover-area">
      <div class="avatar-wrap">
        <div class="avatar">
          <% if (currUser && currUser.profilePhoto && currUser.profilePhoto.url) { %>
            <img src="<%= currUser.profilePhoto.url %>" alt="Photo">
          <% } else { %>
            <%= currUser ? currUser.username.charAt(0).toUpperCase() : 'U' %>
          <% } %>
        </div>
      </div>
    </div>

    <div class="info-section">
      <h2><%= currUser ? currUser.username : 'User' %></h2>
      <div class="email"><%= currUser ? currUser.email : '' %></div>
      <span class="role-badge"><%= currUser && currUser.role === 'owner' ? '👑 Vehicle Owner' : '🚗 Rider' %></span>
      <% if (currUser && currUser.phoneNumber) { %>
        <div class="phone"><i class="fas fa-phone"></i> <%= currUser.phoneNumber %></div>
      <% } %>
      <% if (currUser && currUser.address) { %>
        <div class="phone" style="margin-top:2px;"><i class="fas fa-map-marker-alt"></i> <%= currUser.address %></div>
      <% } %>
    </div>

    <!-- Stats -->
    <div class="stats-row">
      <% if (currUser && currUser.role === 'owner') { %>
        <div class="stat-box"><div class="num"><%= currUser.totalVehicles || 0 %></div><div class="lbl">Vehicles</div></div>
        <div class="stat-box"><div class="num"><%= currUser.totalBookings || 0 %></div><div class="lbl">Bookings</div></div>
        <div class="stat-box"><div class="num"><%= (currUser.averageRating || 0).toFixed(1) %></div><div class="lbl">Rating</div></div>
      <% } else { %>
        <div class="stat-box"><div class="num"><%= currUser.totalTrips || 0 %></div><div class="lbl">Trips</div></div>
        <div class="stat-box"><div class="num"><%= (currUser.averageRating || 0).toFixed(1) %></div><div class="lbl">Rating</div></div>
        <div class="stat-box"><div class="num"><%= currUser.totalReviews || 0 %></div><div class="lbl">Reviews</div></div>
      <% } %>
    </div>
  </div>

  <!-- Edit Profile Form -->
  <div class="profile-card">
    <div class="form-section">
      <form action="/users/profile" method="POST" enctype="multipart/form-data">
        <div class="form-group">
          <label>Username</label>
          <div class="input-wrap">
            <span class="icon"><i class="fas fa-user"></i></span>
            <input value="<%= currUser ? currUser.username : '' %>" disabled>
          </div>
        </div>

        <div class="form-group">
          <label>Email</label>
          <div class="input-wrap">
            <span class="icon"><i class="fas fa-envelope"></i></span>
            <input value="<%= currUser ? currUser.email : '' %>" disabled>
          </div>
        </div>

        <div class="form-group">
          <label>Phone Number</label>
          <div class="input-wrap">
            <span class="icon"><i class="fas fa-phone"></i></span>
            <input name="phoneNumber" value="<%= currUser && currUser.phoneNumber ? currUser.phoneNumber : '' %>" placeholder="Enter your phone number">
          </div>
        </div>

        <% if (currUser && currUser.role === 'owner') { %>
        <div class="form-group">
          <label>Your Address</label>
          <div class="input-wrap">
            <span class="icon"><i class="fas fa-map-marker-alt"></i></span>
            <input name="address" value="<%= currUser && currUser.address ? currUser.address : '' %>" placeholder="City, State">
          </div>
        </div>
        <% } %>

        <div class="form-group">
          <label>Profile Photo</label>
          <div class="input-wrap">
            <span class="icon"><i class="fas fa-camera"></i></span>
            <input type="file" name="profilePhoto" accept="image/*" style="padding:10px 8px;">
          </div>
        </div>

        <button type="submit" class="btn-save"><i class="fas fa-save me-2"></i>Save Changes</button>
      </form>
    </div>
  </div>

  <!-- Logout -->
  <div class="logout-section">
    <button class="btn-logout" onclick="if(confirm('Logout?'))window.location.href='/logout'"><i class="fas fa-sign-out-alt me-2"></i> Logout</button>
  </div>
</div>