<% layout("/listings/layouts/boilerplate") %>
<div class="profile-page fade-in">
  <!-- Profile Card -->
  <div class="card profile-card">
    <div class="profile-cover">
      <div class="profile-avatar">
        <% if (currUser && currUser.profilePhoto && currUser.profilePhoto.url) { %>
          <img src="<%= currUser.profilePhoto.url %>" alt="Photo">
        <% } else { %>
          <span><%= currUser ? currUser.username.charAt(0).toUpperCase() : 'U' %></span>
        <% } %>
      </div>
    </div>
    <div class="profile-info">
      <h2><%= currUser ? currUser.username : 'User' %></h2>
      <span class="badge badge-primary"><%= currUser.email %></span>
      <span class="badge badge-<%= currUser.role === 'owner' ? 'warning' : 'info' %>"><%= currUser && currUser.role === 'owner' ? 'Vehicle Owner' : 'Rider' %></span>
      <% if (currUser && currUser.phoneNumber) { %>
        <p class="text-secondary"><i class="fas fa-phone"></i> <%= currUser.phoneNumber %></p>
      <% } %>
      <% if (currUser && currUser.address) { %>
        <p class="text-secondary"><i class="fas fa-map-marker-alt"></i> <%= currUser.address %></p>
      <% } %>
    </div>

    <!-- Stats -->
    <div class="profile-stats">
      <% if (currUser && currUser.role === 'owner') { %>
        <div class="stat-box"><div class="num"><%= currUser.totalVehicles || 0 %></div><div class="lbl">Vehicles</div></div>
        <div class="stat-box"><div class="num"><%= currUser.totalBookings || 0 %></div><div class="lbl">Bookings</div></div>
        <div class="stat-box"><div class="num"><%= (currUser.averageRating || 0).toFixed(1) %></div><div class="lbl">Rating</div></div>
      <% } else { %>
        <div class="stat-box"><div class="num"><%= currUser.totalTrips || 0 %></div><div class="lbl">Trips</div></div>
        <div class="stat-box"><div class="num"><%= (currUser.averageRating || 0).toFixed(1) %></div><div class="lbl">Rating</div></div>
        <div class="stat-box"><div class="num"><%= currUser.totalReviews || 0 %></div><div class="lbl">Reviews</div></div>
      <% } %>
    </div>
  </div>

  <!-- Edit Profile -->
  <div class="card">
    <div class="card-body" style="padding:32px">
      <h3 style="margin-bottom:24px;font-size:18px;font-weight:700">Edit Profile</h3>
      <form action="/users/profile" method="POST" enctype="multipart/form-data">
        <div class="input-group">
          <label>Username</label>
          <input class="input-field" value="<%= currUser ? currUser.username : '' %>" disabled>
        </div>
        <div class="input-group">
          <label>Email</label>
          <input class="input-field" value="<%= currUser ? currUser.email : '' %>" disabled>
        </div>
        <div class="input-group">
          <label>Phone Number</label>
          <input class="input-field" name="phoneNumber" value="<%= currUser && currUser.phoneNumber ? currUser.phoneNumber : '' %>" placeholder="Enter your phone number">
        </div>
        <% if (currUser && currUser.role === 'owner') { %>
        <div class="input-group">
          <label>Your Address</label>
          <input class="input-field" name="address" value="<%= currUser && currUser.address ? currUser.address : '' %>" placeholder="City, State">
        </div>
        <% } %>
        <div class="input-group">
          <label>Profile Photo</label>
          <input type="file" name="profilePhoto" accept="image/*" class="input-field">
        </div>
        <button type="submit" class="btn btn-primary btn-lg btn-block mt-md"><i class="fas fa-save"></i> Save Changes</button>
      </form>
    </div>
  </div>

  <!-- Logout -->
  <div class="mt-lg" style="text-align:center">
    <a href="/users/logout" class="btn btn-danger" style="width:100%;max-width:400px"><i class="fas fa-sign-out-alt"></i> Logout</a>
  </div>
</div>

<style>
.profile-page { max-width: 540px; margin: 0 auto; padding: 32px 20px; display: flex; flex-direction: column; gap: 20px; }
.profile-card { overflow: hidden; padding: 0; }
.profile-cover { height: 100px; background: var(--gradient); position: relative; }
.profile-avatar { position: absolute; bottom: -40px; left: 50%; transform: translateX(-50%); width: 80px; height: 80px; border-radius: 50%; background: var(--card); border: 4px solid var(--card); display: flex; align-items: center; justify-content: center; font-size: 28px; font-weight: 700; color: var(--primary); overflow: hidden; }
.profile-avatar img { width: 100%; height: 100%; object-fit: cover; }
.profile-info { text-align: center; padding: 52px 20px 20px; }
.profile-info h2 { font-size: 22px; font-weight: 800; margin-bottom: 4px; }
.profile-info p { margin: 4px 0; font-size: 14px; }
.profile-info .badge { margin: 2px 4px; }
.profile-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; padding: 16px 20px; background: var(--surface); margin: 0 20px 20px; border-radius: var(--radius-lg); text-align: center; }
.profile-stats .stat-box .num { font-size: 22px; font-weight: 800; color: var(--primary); }
.profile-stats .stat-box .lbl { font-size: 11px; color: var(--text-secondary); margin-top: 2px; }
</style>
