<% layout("/listings/layouts/boilerplate") %>
<div class="auth-page">
  <div class="auth-card fade-in">
    <a href="/" class="auth-logo">
      <span class="brand-icon"><i class="fa-solid fa-car"></i></span>
      RideLocal
    </a>
    <h1>Welcome back</h1>
    <p class="auth-subtitle">Log in to continue your journey</p>
    <form action="/users/login" method="POST">
      <div class="input-group">
        <label>Username</label>
        <input class="input-field" type="text" name="username" placeholder="Enter your username" required>
      </div>
      <div class="input-group">
        <label>Password</label>
        <input class="input-field" type="password" name="password" placeholder="Enter your password" required>
      </div>
      <button type="submit" class="btn btn-primary btn-lg btn-block mt-md">Log In</button>
    </form>
    <p class="auth-footer">Don't have an account? <a href="/users/signup">Sign up</a></p>
  </div>
</div>

<style>
.auth-page { min-height: calc(100vh - var(--header-height, 72px)); display: flex; align-items: center; justify-content: center; padding: 40px 20px; background: var(--surface); }
.auth-card { background: var(--card); border-radius: var(--radius-xl); padding: 40px; box-shadow: var(--shadow-lg); width: 100%; max-width: 400px; border: 1px solid var(--border-light); }
.auth-logo { display: flex; align-items: center; justify-content: center; gap: 10px; font-weight: 800; font-size: 22px; color: var(--text); margin-bottom: 24px; text-decoration: none; }
.auth-card h1 { font-size: 24px; font-weight: 800; text-align: center; margin-bottom: 4px; }
.auth-subtitle { text-align: center; color: var(--text-secondary); font-size: 14px; margin-bottom: 28px; }
.auth-card .input-group { margin-bottom: 16px; }
.auth-footer { text-align: center; margin-top: 20px; font-size: 14px; color: var(--text-secondary); }
.auth-footer a { color: var(--primary); font-weight: 600; text-decoration: none; }
.auth-footer a:hover { text-decoration: underline; }
</style>
